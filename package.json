{
  "name": "weeklyshopping",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "tsx --tsconfig tsconfig.node.json scripts/build-static-data.ts && vite dev",
    "dev:reset": "node scripts/dev-reset.mjs",
    "build": "tsx --tsconfig tsconfig.node.json scripts/build-static-data.ts && vite build",
    "preview": "pnpm build && vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts",
    "recipe:import": "tsx scripts/import-recipe.ts",
    "content:check": "tsx scripts/check-content.ts",
    "tf:check": "terraform -chdir=infra/terraform fmt -check && terraform -chdir=infra/terraform validate",
    "catalog:build": "tsx scripts/build-catalog.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "blends:reddit": "tsx scripts/build-reddit-blends.ts",
    "recipe:bulk": "tsx scripts/import-bulk.ts",
    "content:clean-html": "tsx scripts/clean-html.ts",
    "content:fix-energy": "tsx scripts/fix-energy.ts",
    "data:build": "tsx --tsconfig tsconfig.node.json scripts/build-static-data.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@trpc/client": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.147.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "sharp",
      "@tailwindcss/oxide"
    ]
  }
}

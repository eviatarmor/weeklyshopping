  "steps": [
    {
      "text": "Boil the potatoes and carrots in a pot of water until soft."
    },
    {
      "text": "Cool, peel and dice. Mix in a bowl with the diced hard-boiled eggs, thawed peas, parsley, white pepper, baking powder, salt, turmeric, lemon juice and the 8 beaten eggs (keep the oil aside)."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Heat the oil in an ovenproof pot or a pan that can go on the stovetop. Pour in the mixture and start cooking on the stove, as for a frittata, for about 5 minutes until it begins to set. Transfer to the oven."
    },
    {
      "text": "Bake for 25 minutes or until the pie is set and golden on top."
    }
  ]

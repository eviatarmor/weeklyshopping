  "steps": [
    {
      "text": "• <ul>\n• <li>Thinly slice onion (see ingredients).</li>\n• <li>Drain and rinse chickpeas. </li>\n• </ul>",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/69b73567d378378da7aae325/step-2a779000.jpg"
    },
    {
      "text": "• <ul>\n• <li>In a large frying pan, heat a drizzle of olive oil over medium-high heat.</li>\n• <li>Cook onion, until tender, 4-5 mins. Add chickpeas and cook until softened, 2-3 mins. </li>\n• <li>Stir through garlic &amp; herb spice blend, light cooking cream and the water. Simmer until slightly reduced, 2-3 mins.</li>\n• <li>Remove pan from heat and stir through red pesto. Season with pepper.  </li>\n• </ul>",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/69b73567d378378da7aae325/step-553cf110.jpg"
    },
    {
      "text": "• <ul>\n• <li>Meanwhile, toast or grill sliced sourdough to your liking.</li>\n• <li>Spread sourdough with the butter.</li>\n• </ul>",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/69b73567d378378da7aae325/step-39b09320.jpg"
    },
    {
      "text": "• <ul>\n• <li>Divide red pesto chickpeas and toasted sourdough between bowls. </li>\n• <li>Sprinkle over the chilli flakes (if using) and top with rocket leaves to serve.</li>\n• </ul>",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/69b73567d378378da7aae325/step-fc603530.jpg"
    }
  ]

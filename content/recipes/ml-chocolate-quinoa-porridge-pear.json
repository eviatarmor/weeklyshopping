  "steps": [
    {
      "text": "Combine quinoa, almond milk, maple syrup, cocoa powder, and salt in a medium saucepan. Whisk to combine and bring to a boil over high heat."
    },
    {
      "text": "Once the quinoa mixture comes to a boil, reduce heat to low, allow to cool slightly, and cover with a lid. Cook until most of the liquid is absorbed, about 20 minutes."
    },
    {
      "text": "During the last 5 minutes of cook time, wash, dry, and thinly slice the pears."
    },
    {
      "text": "To serve, divide chocolate quinoa between bowls and top with pear. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes."
    },
    {
      "text": "Heat a skillet over medium heat."
    },
    {
      "text": "Peel and mince garlic. Halves olives. Measure out capers."
    },
    {
      "text": "Coat bottom of skillet with oil. Add garlic, olives, capers, oregano, and crushed red pepper. Stir and cook for 1-2 minutes."
    },
    {
      "text": "Add tomatoes and bring to a boil. Reduce heat and simmer the sauce while the pasta cooks."
    },
    {
      "text": "Wash basil. Pick leaves off the stems; discard the stems and thinly slice the leaves into ribbons."
    },
    {
      "text": "Drain pasta in a colander."
    },
    {
      "text": "Add pasta to sauce and drizzle with olive oil. Stir in the basil and season with salt and pepper. Toss to combine."
    },
    {
      "text": "To serve, add pasta to a shallow bowl or plate and enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Heat a medium saucepan over medium-high heat."
    },
    {
      "text": "Peel and small dice onion. Peel and mince garlic."
    },
    {
      "text": "Coat bottom of saucepan with oil. Add onion and garlic."
    },
    {
      "text": "Wash celery and bell peppers. Medium dice and add celery to a saucepan. Seed, medium dice, and add peppers to saucepan. Stirring frequently, cook until vegetables have softened, 4-5 minutes."
    },
    {
      "text": "Drain and rinse beans."
    },
    {
      "text": "In a small bowl, mix together chili powder, cumin, salt, black pepper, and cayenne pepper."
    },
    {
      "text": "Add spice mixture, beans, tomatoes, and broth to saucepan. Stir to combine and bring to a boil. Then reduce heat to medium, cover, and simmer until vegetables are tender and chili has thickened, about 10 minutes."
    },
    {
      "text": "Wash green onions, trim and discard root ends, and chop. Stir ½ into the chili and save the rest for garnishing."
    },
    {
      "text": "Serve chili in a bowl, garnish with remaining green onions and spoonfuls of yogurt. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Wash asparagus, snap off woody ends, and cut diagonally into 5 cm pieces."
    },
    {
      "text": "Heat a skillet over medium heat."
    },
    {
      "text": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lemon juice, olive oil, vinegar, honey, salt, and pepper. Set aside."
    },
    {
      "text": "Coat bottom of skillet with oil. Add asparagus and, stirring occasionally, cook until tender and bright green, 5-6 minutes. Remove from heat."
    },
    {
      "text": "Wash and dry arugula. Wash, trim stem ends, and thinly slice strawberries."
    },
    {
      "text": "In a large bowl, combine and toss arugula, strawberries, and asparagus."
    },
    {
      "text": "To serve, arrange salad on a plate, crumble goat cheese over top, sprinkle with almonds, and drizzle with dressing. Enjoy!"
    }
  ]

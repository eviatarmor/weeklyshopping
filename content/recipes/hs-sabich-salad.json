  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Slice the eggplant into 2 cm slices and arrange on a tray. Brush well with olive oil and sprinkle with salt. Place the cherry tomatoes next to the eggplant and bake for 20 minutes, until the eggplant slices are browned and the tomatoes shed their skins."
    },
    {
      "text": "Toss the chopped parsley with a little olive oil, salt and pepper."
    },
    {
      "text": "Spread the tahini over the base of a plate so it covers it completely. Arrange all the ingredients in groups over the tahini."
    },
    {
      "text": "Serve with green chilli and bread if you like."
    }
  ]
}

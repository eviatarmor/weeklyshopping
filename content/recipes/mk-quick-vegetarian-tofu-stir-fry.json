    {
      "name": "Spring Onion",
      "product": "spring-onion",
      "optional": true
    }
  ],
  "steps": [
    {
      "text": "Prepare all the ingredients in bowls on the bench: cube the tofu, crush the garlic, finely chop the chilli, grate the ginger and finely dice the carrot."
    },
    {
      "text": "Heat the sesame oil and olive oil in a pan and fry the tofu on all sides."
    },
    {
      "text": "Add the garlic, chilli and ginger to the pan. Stir for about 1 minute so they do not burn."
    },
    {
      "text": "Add the carrot and peas."
    },
    {
      "text": "Add the soy sauce."
    },
    {
      "text": "Add the cooked rice to the pan and mix. Alternatively, serve the stir-fried vegetables over the rice."
    },
    {
      "text": "Serve with spring onion and more fresh chilli, if you like."
    }
  ]
}

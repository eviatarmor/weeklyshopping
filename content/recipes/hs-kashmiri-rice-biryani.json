  "steps": [
    {
      "text": "Soak the rice in water for about 15 minutes."
    },
    {
      "text": "Heat the oil in a medium pot and fry the diced carrots and the spices (except the salt)."
    },
    {
      "text": "Drain the rice and rinse it well under cold water. Add it to the pot and fry for about 2 minutes with the vegetables."
    },
    {
      "text": "Add the peas, water and salt. Bring to the boil, reduce the heat, cover and cook over low heat for about 15 minutes. When holes start to form in the rice, remove from the heat and leave covered for another 10 minutes."
    },
    {
      "text": "Pour the saffron soaking water over the rice if using. Top with coriander, cashews and fried onion."
    }

  "steps": [
    {
      "text": "Cook the pasta according to the packet instructions, drain and reserve 1 cup of the cooking water."
    },
    {
      "text": "Fry the olive oil, sliced garlic and chilli flakes in a wide pan over low heat for about 3 minutes. Add the reserved pasta water, the lemon juice, 1 tbsp grated lemon zest, the butter, the roughly chopped parsley, salt and pepper. Cook for 3 minutes over high heat."
    },
    {
      "text": "Add the pasta and toss well. Remove from the heat, sprinkle generously with parmesan and serve."
    }

  "steps": [
    {
      "text": "Wash, dry, trim, and small dice celery. Place in a medium bowl."
    },
    {
      "text": "Wash, dry, trim, and seed bell peppers; small dice. Add to the bowl with the celery."
    },
    {
      "text": "Preheat a large pot over medium heat."
    },
    {
      "text": "While the pot heats up, peel, halve, and small dice onion. Add to the bowl."
    },
    {
      "text": "Once the pot is hot, add oil and swirl to coat the bottom. Add the veggies and cook, stirring occasionally, until starting to soften, 4-5 minutes."
    },
    {
      "text": "Meanwhile, drain and rinse beans."
    },
    {
      "text": "When the veggies are soft, add beans, broth, tomatoes, and spices to the pot; stir to combine. Bring to a boil over high heat, then reduce heat and simmer until flavors blend, about 5 minutes. Remove from heat."
    },
    {
      "text": "To serve, divide soup between bowls. Top with cheese and chips. Enjoy!"
    }
  ]

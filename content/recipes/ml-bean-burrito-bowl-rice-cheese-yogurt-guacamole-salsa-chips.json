  "steps": [
    {
      "text": "Drain and rinse beans; transfer to a medium saucepan."
    },
    {
      "text": "Using a strainer or colander, rinse the rice under cold, running water, then drain and add to the pan with the beans. Add water and taco seasoning; bring the mixture to a boil over high heat."
    },
    {
      "text": "Once the liquid comes to a boil, stir the mixture, cover the saucepan, and reduce heat to low. Cook until liquid is fully absorbed, about 15 minutes."
    },
    {
      "text": "Meanwhile, wash and dry the fresh produce."
    },
    {
      "text": "Halve lettuce lengthwise, then chop crosswise into thin (shred-like) strips; place in a medium bowl."
    },
    {
      "text": "Halve tomatoes and add to the bowl with the lettuce."
    },
    {
      "text": "Trim and thinly slice radishes; add to the bowl and toss to combine the salad."
    },
    {
      "text": "Slice lime into wedges."
    },
    {
      "text": "Divide rice and beans, salad, chips, cheese, yogurt, and lime wedges between bowls; serve with guacamole and salsa on the side. Enjoy!"
    }
  ]

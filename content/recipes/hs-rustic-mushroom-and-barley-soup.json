  "steps": [
    {
      "text": "Heat a large pot with the olive oil and fry the finely chopped onion, diced carrots, fennel and kohlrabi for 5 minutes until the onion is golden. Add the soup seasoning and finely chopped garlic and fry for 1 minute until fragrant."
    },
    {
      "text": "Add the diced potatoes and mushrooms and fry for 3 minutes until the mushrooms start to turn golden. Add the pearl barley, salt and pepper and stir."
    },
    {
      "text": "Pour in 1.5 litres of boiling water and bring to the boil. Cover and cook for 30 minutes over low heat until the barley is soft."
    },
    {
      "text": "Add the chopped dill, stir and adjust the seasoning. Serve immediately."
    }
  ]

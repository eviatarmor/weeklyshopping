  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Heat a frying pan with 3 tbsp olive oil. Add the zucchini slices (2-3 mm thick), season with salt and oregano and fry for 3-5 minutes until golden. Spread in an even layer in a baking dish."
    },
    {
      "text": "Add the remaining oil to the pan and fry the halved tomatoes with the crushed garlic for 2 minutes to evaporate the liquid. Scatter over the zucchini."
    },
    {
      "text": "Mix the eggs, cottage cheese and sour cream in a bowl, season with salt and pour over the zucchini and tomatoes."
    },
    {
      "text": "Bake for about 35 minutes until golden."
    }
  ]

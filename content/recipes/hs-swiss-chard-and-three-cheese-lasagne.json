  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "For the filling, mix the finely chopped silverbeet, chopped basil, mashed ricotta and crumbled blue cheese."
    },
    {
      "text": "For the white (royale) sauce, whisk the cream, eggs, salt, pepper, nutmeg and crushed garlic with a fork. Keep 1 cup of the sauce aside and stir the rest into the chard mixture."
    },
    {
      "text": "Pour 0.5 cup of the reserved sauce into a rectangular baking dish and lay lasagne sheets on top, slightly overlapping. Cover with a third of the chard mixture and sprinkle with a little cheddar and parmesan. Repeat the layers and finish with white sauce, cheddar and parmesan."
    },
    {
      "text": "Bake for 45 minutes or until the top is golden."
    }
  ]

  "steps": [
    {
      "text": "Prep cake pan: Preheat the oven to 180C, fan-forced. Grease a 20cm square cake pan and line the base and sides with baking paper, allowing the paper to extend over the sides.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590184/photos/large/379001_1-8158fcf9a89688f5d7cbbb3a5f56de86.jpeg"
    },
    {
      "text": "Make brownie mixture: Put the brownie mix, cranberries, hazelnuts, pistachios, 180ml (¾ cup) vegetable oil, 80ml (⅓ cup) milk, 2 eggs and a pinch of salt in a large bowl and stir with a wooden spoon until well combined.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590186/photos/large/379001_2-850f5fbc8cd6dd7c50e02cbe4a9f9753.jpeg"
    },
    {
      "text": "Bake brownie: Pour the brownie mixture into the pan and smooth the surface with the back of the spoon. Bake for 40 mins or until just firm to the touch but still a little soft in the middle.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590188/photos/large/379001_3-2c58eb29d3998115e8ac9b804a063ea5.jpeg"
    },
    {
      "text": "Cool brownie: Leave the brownie to cool in the pan for 15 mins, then transfer to a wire rack to cool completely.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590189/photos/large/379001_4-67748553711fa9d215a8955141720ff9.jpeg"
    },
    {
      "text": "Serve up: Cut the brownie into squares and enjoy as a sweet little snack!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590190/photos/large/379001_5-5ee6b0c70f3ef80250ea13bfc891742f.jpeg"
    },
    {
      "text": "Kitchen 101: Store the brownies in an airtight container for up to 2 days. Makes 9 brownies.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2590191/photos/large/379001_6-6008943387a372362a097cc2b5e7fe2e.jpeg"
    }
  ]
}

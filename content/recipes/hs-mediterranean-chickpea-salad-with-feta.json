  "steps": [
    {
      "text": "Steam the broccoli florets for about 5 minutes until tender. Cool to room temperature and set aside."
    },
    {
      "text": "Steam the pumpkin slices for about 10 minutes until tender. Cool to room temperature and set aside."
    },
    {
      "text": "For the dressing, mix the tahini, lemon juice, olive oil, date syrup, cold water, crushed garlic, cumin and salt in a bowl."
    },
    {
      "text": "In a large bowl, combine the feta, broccoli, pumpkin, chickpeas, torn kale, red cabbage, red onion and almonds. Season with salt and pepper, toss with the dressing, scatter with chopped herbs and serve."
    }

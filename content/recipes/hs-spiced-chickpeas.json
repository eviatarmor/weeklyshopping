  "steps": [
    {
      "text": "Cut the tomatoes into eighths, slice the onion thinly, chop the garlic finely and grate the ginger."
    },
    {
      "text": "Heat the oil in a wide pot over medium heat and fry the coriander seeds, cumin seeds and chilli for a few seconds. Add the onion, lower the heat and fry for 5 to 6 minutes until soft and lightly golden."
    },
    {
      "text": "Add the tomatoes, garlic and ginger, raise to medium heat and fry for 2 minutes."
    },
    {
      "text": "Add the chickpeas, salt, pepper, tamarind and water. Cover, lower the heat and cook for 10 minutes."
    },
    {
      "text": "Raise to medium heat, add the yoghurt, garam masala and chopped parsley, and cook for 10 minutes until the sauce thickens and reduces. Serve with rice."
    }
  ]

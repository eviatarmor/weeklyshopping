  "steps": [
    {
      "text": "Put the soaked black-eyed peas in a pot, cover with water and bring to the boil. Reduce the heat and cook covered for 40 minutes until tender. Do not salt, as salt slows the softening."
    },
    {
      "text": "Heat the oil in another pot, add all the dry spices and fry for 1 minute until fragrant. Add the finely chopped onions, chillies, garlic-ginger paste and curry leaves and fry for 3 to 4 minutes until the onion turns slightly golden."
    },
    {
      "text": "Add the grated tomatoes, the cooked beans with their cooking liquid and 2 cups of water and bring to the boil. Cover and cook over medium heat for 15 minutes until slightly thickened. Season with salt a few minutes before the end."
    },
    {
      "text": "Serve hot with white rice or chapati. Keeps in the fridge for up to 4 days."
    }
  ]

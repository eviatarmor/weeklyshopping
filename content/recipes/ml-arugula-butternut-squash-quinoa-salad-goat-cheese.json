  "steps": [
    {
      "text": "Preheat oven to 450°F."
    },
    {
      "text": "In a small saucepan, combine quinoa and broth. Bring to a boil. Reduce heat to a simmer, cover, and cook for 15 minutes. Remove from heat and let stand, covered, for 5 minutes."
    },
    {
      "text": "Peel squash, scrape out and discard the seeds, and medium dice the flesh. Transfer to a sheet pan."
    },
    {
      "text": "Drizzle squash with oil and season with salt and pepper. Toss to coat."
    },
    {
      "text": "Place in the oven and roast until squash is tender, 10-15 minutes."
    },
    {
      "text": "Wash and dry arugula. Transfer to a large bowl."
    },
    {
      "text": "Peel and thinly slice onion into half rings. Add to bowl."
    },
    {
      "text": "Add almonds and cranberries to bowl."
    },
    {
      "text": "In a small bowl, prepare dressing by whisking together lemon juice, oil, vinegar, salt, and pepper."
    },
    {
      "text": "Cut remaining lemon into wedges."
    },
    {
      "text": "Crumble goat cheese into a small bowl."
    },
    {
      "text": "Uncover quinoa and fluff with a fork. Add quinoa and squash to salad and toss."
    },
    {
      "text": "To serve, place salad on a plate, sprinkle with goat cheese, and drizzle with dressing. Enjoy!"
    }
  ]

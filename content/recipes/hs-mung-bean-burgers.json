  "steps": [
    {
      "text": "Boil the potato in water for about 20 minutes until soft. Cool and peel."
    },
    {
      "text": "Meanwhile, cook the mung beans in a pot of boiling water for 15 minutes until they begin to soften but are not completely soft. Drain."
    },
    {
      "text": "Process the mung beans and potato in a food processor with the onion, garlic, paprika, salt and pepper into a grainy paste. Taste and adjust the seasoning."
    },
    {
      "text": "Preheat the oven to 200°C."
    },
    {
      "text": "Divide the mixture into 4 equal portions. With oiled hands, shape large patties and place on a tray lined with baking paper."
    },
    {
      "text": "Bake for 15 minutes."
    },
    {
      "text": "Serve hot in buns with lettuce, tomato, pickles, tomato sauce and mayonnaise."
    }
  ]

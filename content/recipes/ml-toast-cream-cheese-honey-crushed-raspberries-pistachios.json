  "steps": [
    {
      "text": "Preheat oven to broil on high and position rack in the upper third of the oven."
    },
    {
      "text": "Wash and dry raspberries; place in a medium bowl along with honey, cardamom, and cinnamon. Using a fork or potato masher, gently crush the raspberries until they reach a chunky, jam-like consistency. Set aside."
    },
    {
      "text": "Arrange bread on a large baking sheet pan. Place in the oven and broil, flipping halfway through, until toasted, 2-3 minutes. Remove from oven."
    },
    {
      "text": "Meanwhile, roughly chop pistachios."
    },
    {
      "text": "Spread cream cheese over the toast, then top with crushed raspberries and pistachios."
    },
    {
      "text": "To serve, divide toasts between plates and enjoy!"
    }
  ]

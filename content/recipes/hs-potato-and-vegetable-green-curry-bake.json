  "steps": [
    {
      "text": "Cook the potatoes in the microwave or in boiling water for 7 minutes until they begin to soften. Drain and transfer to a baking dish."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Heat the oil in a very hot wok and stir-fry the diced onion, carrot, capsicum, finely chopped chilli, celery and tomatoes in that order. Add the curry paste, chopped garlic, water, coconut milk and sweet chilli sauce. Season with salt, chopped ginger and chopped white part of the lemongrass and mix well."
    },
    {
      "text": "Pour the contents of the wok over the potatoes, cover and bake (or simmer) together for about 20 minutes."
    },
    {
      "text": "Remove the cover, add the peas and bake (or simmer) for 5 more minutes. Sprinkle with chopped coriander and serve immediately."
    }
  ]

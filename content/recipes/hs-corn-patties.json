  "steps": [
    {
      "text": "Shave the kernels off the corn cobs with a sharp knife and blitz three quarters of the corn in a food processor with 2 to 3 pulses."
    },
    {
      "text": "Heat the olive oil in a medium pot, add the chopped onion and fry for 3 to 4 minutes over medium heat until golden. Add the blitzed and whole corn and cook, stirring, for 3 to 4 minutes. Add the finely grated zucchini, chopped spinach, salt and pepper, remove from the heat and let cool for 10 minutes."
    },
    {
      "text": "Add the flaxseed, oats, baking powder, water and almond butter to the vegetables, mix and refrigerate for 10 minutes."
    },
    {
      "text": "Preheat the oven to 220°C and line a tray with baking paper greased with olive oil."
    },
    {
      "text": "Form flattened patties with wet hands, place on the tray and bake for 15 minutes until golden and crisp. Serve with cashew mayonnaise, tortillas and cut vegetables."
    }
  ]

  "steps": [
    {
      "text": "Fill a bowl with hot water, add the buckwheat, stir and soak for 15 minutes."
    },
    {
      "text": "Heat the oil in a pot and add the sliced mushrooms, chopped spring onions, grated carrot, chopped capsicum and garlic. Fry for about 10 minutes, stirring. Add the peeled, chopped tomatoes and the spices."
    },
    {
      "text": "Drain the buckwheat and add it to the pot. Stir and fry everything together for about 10 minutes."
    },
    {
      "text": "Add 600 ml of water, stir, cover the pot and bring to the boil."
    },
    {
      "text": "Reduce the heat and cook for about half an hour, or until the liquid has fully evaporated."
    },
    {
      "text": "Add the chopped coriander leaves and serve."
    }
  ]

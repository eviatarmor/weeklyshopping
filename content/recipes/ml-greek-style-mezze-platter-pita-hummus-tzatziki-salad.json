  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Trim, seed, and halve bell peppers crosswise, then slice into thin strips. Place in a large bowl."
    },
    {
      "text": "Trim and halve cucumber lengthwise, then slice crosswise into thin half-moons. Add to the bowl with the bell pepper."
    },
    {
      "text": "Chop or tear lettuce into bite-sized pieces. Add to the bowl."
    },
    {
      "text": "Peel, halve, and slice shallots crosswise into thin half-moons. Add to the bowl."
    },
    {
      "text": "Drain and roughly chop artichokes. Add to the bowl."
    },
    {
      "text": "Roughly chop olives. Add to the bowl, along with the feta, vinaigrette, and oregano. Toss to combine the salad and set aside."
    },
    {
      "text": "Toast pita if desired, then cut into wedges."
    },
    {
      "text": "Divide salad and pita between plates; serve with hummus and tzatziki. Enjoy!"
    }

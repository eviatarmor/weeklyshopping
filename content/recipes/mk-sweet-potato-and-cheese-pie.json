  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Place the thinly sliced sweet potato in a bowl and cover with water. Microwave for 8 to 10 minutes until softened. Drain."
    },
    {
      "text": "Mix all the other ingredients in a bowl, saving a little grated cheese for the top. Add the sweet potato last, mix gently and transfer to a greased baking dish."
    },
    {
      "text": "Sprinkle with grated cheese and bake for about 35 minutes, until golden."
    },
    {
      "text": "Let it cool slightly before serving."
    }

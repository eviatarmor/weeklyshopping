  "steps": [
    {
      "text": "Preheat oven to 400°F."
    },
    {
      "text": "Peel and mince garlic. In a small bowl, mix together garlic, oil, salt, and pepper."
    },
    {
      "text": "Wash, dry, and halve tomatoes."
    },
    {
      "text": "Measure out 2 cups of ricotta."
    },
    {
      "text": "Place flatbreads on a flat surface. Spoon oil and garlic mixture over top, add tomatoes, and finish off with spoonfuls of ricotta."
    },
    {
      "text": "Place in the oven, directly on the rack, and bake until cheese melts, 8-10 minutes. Then broil for 1-2 minutes."
    },
    {
      "text": "Wash and dry arugula and basil. Pick basil leaves off the stems; discard the stems and thinly slice the leaves into ribbons."
    },
    {
      "text": "In a small bowl, prepare salad dressing by whisking together oil, vinegar, Dijon, salt, and pepper."
    },
    {
      "text": "Remove pizzas from oven and garnish with basil; slice into wedges."
    },
    {
      "text": "To serve, place pizza on a plate and have salad on the side. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Soak fruit: Line an oven tray with baking paper. Put the figs, apricots, maple syrup, 1 tbs olive oil and 2 tbs boiling water in a heatproof bowl and stir to combine. Soak for 5 mins or until softened.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245923/photos/large/soak_fruit-ec15e68642d746c540b8e70ae86aaef1.jpeg"
    },
    {
      "text": "Process coconut: Meanwhile, put the coconut in a food processor and pulse until coarsely chopped. Transfer half the coconut to a large bowl.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245924/photos/large/process_coconut-15441d169a953f6052374005a17654ad.jpeg"
    },
    {
      "text": "Process nuts and fruit: Add the cashews to the coconut in the food processor and process until finely chopped. Add the almond meal and fruit mixture and process until combined.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245925/photos/large/process_nuts_and_fruit-2135240ae5b719a97dd15f6cf1afd931.jpeg"
    },
    {
      "text": "Shape logs: Using damp hands, roll tablespoons of the mixture into 20 balls, then shape into logs about 5cm in length. Put on the lined tray.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245926/photos/large/shape_logs-edcfe2f9c21755a98cc920218b6fd021.jpeg"
    },
    {
      "text": "Coat logs: Roll the logs in the remaining coconut to coat. Transfer to an airtight container and refrigerate for at least 2 hours before serving. Store in the fridge for up to 1 week. Enjoy! Makes 20 bliss logs (1 per serve).",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245927/photos/large/coat_logs-feb4bcf2a666e48ce6fce2b7148a6eb9.jpeg"
    },
    {
      "text": "Make it again: Use this recipe for bliss logs to make your own version! Think roasted walnuts or macadamias instead of cashews, or swap the figs for dates. For a protein boost, add 2 tsp chia seeds.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/245928/photos/large/make_it_again-f710eae63b9d0989514e6c590f40c9bc.jpeg"
    }
  ]
}

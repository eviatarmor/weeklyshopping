  "steps": [
    {
      "text": "Heat a large pot over medium heat."
    },
    {
      "text": "Peel and small dice onion. Peel and mince garlic and ginger."
    },
    {
      "text": "Coat bottom of pot with oil. Add onion and, stirring frequently, cook until softened, 3-4 minutes."
    },
    {
      "text": "Rinse lentils under cold water."
    },
    {
      "text": "Wash potatoes and tomatoes. Peel and large dice the potatoes. Medium dice the tomatoes."
    },
    {
      "text": "Add garlic, ginger, cumin, turmeric, curry, coriander, and salt to pot. Stir for about 1 minute."
    },
    {
      "text": "Add potatoes, tomatoes, lentils, and broth. Bring to a simmer and cook until potatoes and lentils are tender, 15-20 minutes."
    },
    {
      "text": "Toast bread."
    },
    {
      "text": "To serve, add stew to a bowl and have with bread on the side. Enjoy!"
    }
  ]

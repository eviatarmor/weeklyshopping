  "steps": [
    {
      "text": "Halve the leek lengthwise and slice thinly. Slice the button and portobello mushrooms and break the wild mushrooms into pieces. Roughly chop the walnuts."
    },
    {
      "text": "Heat the olive oil in a large frying pan and saute the leek for 3 minutes until soft."
    },
    {
      "text": "Add the mushrooms and walnuts, season with salt and pepper and stir-fry for 3 minutes until golden."
    },
    {
      "text": "Add the cold cooked rice and the vegetable stock and stir for 3 minutes to heat through. Serve immediately."
    }
  ]

  "steps": [
    {
      "text": "Cook the egg noodles according to the packet directions, drain and set aside."
    },
    {
      "text": "Heat a wide frying pan over high heat until very hot."
    },
    {
      "text": "Just before stir-frying, make the sauce. Blend the basil, coriander, sugar, coconut cream and chilli sauce with a stick blender until smooth."
    },
    {
      "text": "Add the oil, finely chopped garlic, white part of the spring onions and ginger to the pan and stir-fry for 20 seconds until fragrant. Add the capsicum strips and sliced leek and stir for 30 to 50 seconds, just until they start to soften."
    },
    {
      "text": "Add the green spring onion, chives and noodles, then pour in the sauce. Bring to the boil and stir well until the sauce is absorbed. Season with salt."
    },
    {
      "text": "Transfer to plates and top with bean sprouts, chopped peanuts and lime wedges."
    }
  ]

  "steps": [
    {
      "text": "Peel and mince shallots and garlic."
    },
    {
      "text": "Preheat a skillet over medium heat."
    },
    {
      "text": "Add oil and swirl to coat the bottom of the skillet; add shallots and garlic. Cook, stirring occasionally, until softened, about 2 minutes."
    },
    {
      "text": "Add peas and water to pan; cook until almost no liquid remains, about 5 minutes."
    },
    {
      "text": "Wash and juice lemon into a medium bowl."
    },
    {
      "text": "Add pea mixture and mayonnaise to the bowl with the lemon juice; season with salt and pepper. Using a potato masher, mash until almost smooth."
    },
    {
      "text": "Toast bread if desired."
    },
    {
      "text": "Wash and slice tomato."
    },
    {
      "text": "To serve, spread mashed peas over toast, top with tomato, salt, and pepper. Enjoy!"
    }
  ]

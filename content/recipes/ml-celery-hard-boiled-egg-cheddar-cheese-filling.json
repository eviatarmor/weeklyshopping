  "steps": [
    {
      "text": "Place mayo and spices in a medium bowl. Stir to combine the dressing."
    },
    {
      "text": "Using a box grater, coarsely grate eggs. Add to the bowl with the dressing."
    },
    {
      "text": "Coarsely grate cheese. Add to the bowl, stir to combine the filling, and set aside."
    },
    {
      "text": "Wash, dry, and trim celery, then cut crosswise into 4-inch long sticks."
    },
    {
      "text": "Stuff celery sticks with the filling."
    },
    {
      "text": "To serve, divide stuffed celery sticks between plates. Sprinkle with paprika and enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Peel and thinly slice onion into half rings."
    },
    {
      "text": "Heat a large pot over medium heat."
    },
    {
      "text": "Peel and mince ginger and garlic."
    },
    {
      "text": "Once the pot is hot, add oil and swirl to coat the bottom."
    },
    {
      "text": "Add onion, ginger, garlic, and chili-garlic sauce to the pot. Cook, stirring frequently, until onion begins to soften, 3-4 minutes."
    },
    {
      "text": "Add broth, coconut milk, sugar, and salt to the pot. Bring to a boil over high heat, then reduce heat to a simmer."
    },
    {
      "text": "Thinly slice mushrooms."
    },
    {
      "text": "Drain and small dice tofu."
    },
    {
      "text": "Add mushrooms and tofu to the pot and continue to simmer for 10 minutes."
    },
    {
      "text": "Meanwhile, trim green onions; cut crosswise into ¼-inch pieces."
    },
    {
      "text": "Shave cilantro leaves off the stems; discard stems."
    },
    {
      "text": "When the soup is done, juice lime into the pot and stir to combine."
    },
    {
      "text": "To serve, divide soup between bowls. Top with green onions and cilantro. Enjoy!"
    }
  ]

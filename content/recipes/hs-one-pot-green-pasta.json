  "steps": [
    {
      "text": "Arrange the pasta, onion, broccoli, zucchini, peas, spinach, garlic, herbs, salt, pepper and chilli in a large pot and add the boiling water."
    },
    {
      "text": "Bring to the boil and cook for 10 to 15 minutes, until the pasta is tender. Drain any remaining water. Add the diced butter and keep cooking, stirring, for 1 more minute."
    },
    {
      "text": "Crumble over the feta, sprinkle with chilli flakes and fresh green leaves and serve immediately."
    }

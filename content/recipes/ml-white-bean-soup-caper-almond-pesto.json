  "steps": [
    {
      "text": "This recipe will make about 8 cups. Work in batches to best fit your blender."
    },
    {
      "text": "Drain and rinse the beans in a colander."
    },
    {
      "text": "Peel and roughly chop the onion; peel and mince the garlic."
    },
    {
      "text": "In a blender, combine beans, onion, garlic, broth, almond milk, and spices. Blend on high until smooth."
    },
    {
      "text": "Pour soup into a large pot, cover and place over medium heat. Cook, stirring occasionally, until warmed through and fragrant, about 15 minutes."
    },
    {
      "text": "Meanwhile, wash and pick basil leaves off the stems; roll up crosswise, and mince. Place in a small bowl."
    },
    {
      "text": "Finely chop the almonds and capers; add both to the bowl with the basil."
    },
    {
      "text": "Add oil and spices to the bowl with the basil and capers. Stir to combine the pesto."
    },
    {
      "text": "To serve, divide soup between bowls; drizzle with olive oil and top with pesto. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Place yogurt, mayo, vinegar, sugar, and spices in a medium bowl; whisk to combine the dressing."
    },
    {
      "text": "Wash, dry, and separate broccoli into bite-sized florets; cut stems into smaller pieces. Add to the bowl with the dressing."
    },
    {
      "text": "Wash, dry, and halve grapes. Add to the bowl."
    },
    {
      "text": "Add blue cheese to the bowl and stir to combine the salad."
    },
    {
      "text": "To serve, divide salad between plates or bowls and enjoy!"
    }

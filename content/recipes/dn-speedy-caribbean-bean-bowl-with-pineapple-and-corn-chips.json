  "steps": [
    {
      "text": "Prep ingredients: Finely chop the cucumber and tomato. Cut the lime into wedges. Crush or finely chop the garlic. Drain and rinse the beans. Reserve 1 tbs pineapple juice, then drain the pineapple pieces.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219806/photos/large/167244_1-31c222ee54639a572ab2ae3897259e28.jpeg"
    },
    {
      "text": "Cook garlic: Heat a drizzle of olive oil in a medium saucepan over medium heat. Cook the garlic, stirring, for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219807/photos/large/167244_2-ed4e0098b99308b8f8707548ff07d970.jpeg"
    },
    {
      "text": "Warm beans: Add the beans and Caribbean seasoning to the garlic and cook, stirring, for 3-4 mins until the beans are coated and warmed through.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219808/photos/large/167244_3-25dd5519b6406cd753b4935f6a5e1e06.jpeg"
    },
    {
      "text": "Add pineapple: Add the pineapple and reserved pineapple juice to the beans and cook, stirring, for a further 1 min or until the pineapple is warm and the mixture is combined. Remove the pan from the heat. Taste, then season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219809/photos/large/167244_4-4b417261c9239bb2c3b5a21aa446471c.jpeg"
    },
    {
      "text": "Serve up: Divide the corn chips, bean mixture, cucumber and tomato among bowls. Serve with the lime wedges and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219810/photos/large/167244_5-7ecdd93908a1a934d0554f56aeb5844d.jpeg"
    },
    {
      "text": "Make it yours: Feel free to add other salad goodies from your veggie drawer, such as coriander leaves or sliced avocado.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4219811/photos/large/167244_6-c9775aa2feb242e1d983672cdfe22d86.jpeg"
    }
  ]
}

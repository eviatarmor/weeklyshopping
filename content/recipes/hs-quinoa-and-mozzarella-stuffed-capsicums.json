  "steps": [
    {
      "text": "Halve the capsicums, remove the seeds and roast with a little oil for 20 minutes at 220°C. Set aside."
    },
    {
      "text": "Rinse the quinoa well and place in a pot with 2 cups of water. Bring to the boil and, as soon as it starts to absorb the water, reduce the heat, cover and cook for 10 minutes."
    },
    {
      "text": "Fry the eggplant sticks in hot oil, then drain on paper towel to soak up excess oil."
    },
    {
      "text": "Transfer the cooked quinoa to a bowl and mix with the herbs, sun-dried tomatoes, walnuts and hazelnuts, capers, vinegar, almonds, cumin, diced mozzarella and a little olive oil. Season with salt and pepper."
    },
    {
      "text": "Fill the capsicums with the mixture, arrange on a baking tray and bake for 10 minutes at 180°C. Scatter over some parsley leaves and serve with the eggplant chips."
    }
  ]

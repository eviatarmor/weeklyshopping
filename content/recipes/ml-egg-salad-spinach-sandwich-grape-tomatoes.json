  "steps": [
    {
      "text": "Place eggs in a small saucepan, cover with water, and bring to a boil. Reduce heat to a simmer and cook for 8 minutes. Drain hot water and add ice or run under cold water to cool."
    },
    {
      "text": "Peel and mince garlic. In a large bowl, prepared dressing by mixing together garlic, mayo, Dijon, dill, paprika, salt, and pepper."
    },
    {
      "text": "Wash celery and green onions. Small dice celery and add to bowl with dressing. Trim and discard green onion roots ends, chop, and add to bowl."
    },
    {
      "text": "Wash and dry spinach."
    },
    {
      "text": "Wash tomatoes."
    },
    {
      "text": "Toast bread."
    },
    {
      "text": "Peel, medium dice, and add eggs to bowl with other ingredients. Stir to combine."
    },
    {
      "text": "Place bread in pairs on a flat surface. Arrange spinach leaves over one slice of bread in each pair, then top with egg salad and a second slice of bread."
    },
    {
      "text": "Serve sandwiches with tomatoes on the side and enjoy!"
    }
  ]

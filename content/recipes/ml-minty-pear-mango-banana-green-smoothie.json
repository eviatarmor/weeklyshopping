  "steps": [
    {
      "text": "This recipe will make about 8 cups. Work in batches to best fit your blender."
    },
    {
      "text": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed)."
    },
    {
      "text": "Roughly chop cucumber; transfer to a blender along with cold water and maple syrup. Blend until smooth."
    },
    {
      "text": "Core and roughly chop pears; add to the blender."
    },
    {
      "text": "Juice lime into the blender."
    },
    {
      "text": "Pick mint leaves off the stems; discard stems and add leaves to the blender."
    },
    {
      "text": "Peel the bananas, break into chunks and add to the blender along with the spinach."
    },
    {
      "text": "Add 8 ice cubes, edamame, and mango to the blender. Blend on high speed for several minutes until smooth."
    },
    {
      "text": "Pour the smoothie into glasses and enjoy!"
    }
  ]
}

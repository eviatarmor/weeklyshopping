  "steps": [
    {
      "text": "Soak the porcini in boiling water for 20 minutes, then squeeze dry and slice if needed."
    },
    {
      "text": "Bring the vegetable stock to the boil in a pot, add the cream and bring to the boil again. Reduce the heat."
    },
    {
      "text": "Heat olive oil in a pan, add the garlic and onion and saute for about 2 minutes. Add the risotto rice and fry, stirring, until it starts to toast. Add the porcini and portobello mushrooms and stir."
    },
    {
      "text": "Add the white wine, then the hot stock a ladle at a time, stirring and letting the liquid absorb a little before each addition. Season with salt and pepper to taste."
    },
    {
      "text": "Stir in the butter and parmesan until melted into the risotto and serve."
    }
  ]

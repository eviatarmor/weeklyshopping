  ],
  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Cook the noodles in boiling salted water until tender. Drain and let cool slightly."
    },
    {
      "text": "In a large bowl mix all the cheeses, eggs, cream and remaining ingredients."
    },
    {
      "text": "Add the cooked noodles to the cheese mixture and mix until everything is coated."
    },
    {
      "text": "Grease a baking dish and transfer the mixture into it."
    },
    {
      "text": "Bake for 40 to 50 minutes, until golden and set."
    },
    {
      "text": "Let cool slightly, slice and serve warm or at room temperature."
    }
  ]

  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Heat the olive oil in a frying pan over medium heat. Fry the chopped onions for 3 minutes until translucent."
    },
    {
      "text": "Chop the mushrooms in a food processor, add them to the pan and keep frying over high heat for only 2 to 3 minutes so they do not release liquid."
    },
    {
      "text": "Transfer the mixture to a bowl and let it cool completely. Add the garlic, cheeses, almond meal, parsley, oregano, dried mushroom powder, salt and pepper and mix well."
    },
    {
      "text": "Slit each pepper lengthways, almost to the end, leaving the stem intact. Gently open and fill with a tablespoon or two of the stuffing, without overfilling."
    },
    {
      "text": "Grease a rectangular serving dish with olive oil. Arrange the peppers side by side, brush or spray with olive oil and bake for about 30 minutes, until golden."
    }
  ]

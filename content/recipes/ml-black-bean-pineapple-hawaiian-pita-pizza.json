  "steps": [
    {
      "text": "Peel and slice the onion into thin half rings."
    },
    {
      "text": "Wash and dry the pineapple. Cut skin off pineapple, core, and cut into bite-sized pieces."
    },
    {
      "text": "Drain and rinse the beans in a colander; set aside to drain further."
    },
    {
      "text": "Peel and mince garlic."
    },
    {
      "text": "In a medium bowl, combine garlic, tomato sauce, and spices. Stir to combine and set aside."
    },
    {
      "text": "Preheat oven to broil."
    },
    {
      "text": "Grate the mozzarella."
    },
    {
      "text": "To assemble, top the pitas with a thin layer of tomato sauce, cheese, red onion, pineapple, and black beans. Place on a baking sheet and cook in the oven for 2-3 minutes, until the cheese melts."
    },
    {
      "text": "Wash and dry cilantro. Shave leaves off the stems; discard the stems."
    },
    {
      "text": "Remove from oven and top with cilantro leaves. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Cook the cauliflower florets in a pot of salted water for 5 minutes until slightly soft. Drain."
    },
    {
      "text": "Heat the oil with the cumin and fennel seeds and fry for a few seconds."
    },
    {
      "text": "Add the garlic and ginger paste and the crushed tomatoes and stir. Add the ground spices and cook for 5 minutes."
    },
    {
      "text": "Add the cooked cauliflower, season with salt and cover. Cook for about 15 minutes over medium heat."
    },
    {
      "text": "Pour in the cream, stir and turn off the heat. Serve hot with chopped coriander on top, with rice if you like."
    }

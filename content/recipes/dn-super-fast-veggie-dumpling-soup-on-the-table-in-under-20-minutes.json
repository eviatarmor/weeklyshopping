  "steps": [
    {
      "text": "Prep ingredients: Cut the pak choy into thirds, keeping the stems and leaves separate. Thinly slice the radish. Coarsely chop the peanuts.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865731/photos/large/70085_1-1d0ca012c43411ceb679e75ca8d532e5.jpeg"
    },
    {
      "text": "Pickle radish: Put 3 tsp white vinegar and 1½ tsp sugar in a bowl and stir until the sugar dissolves. Add the radish and toss to combine. Set aside to pickle, tossing occasionally, until needed.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865732/photos/large/70085_2-cbd2f5db4d65f8bfd39304f55736778c.jpeg"
    },
    {
      "text": "Prep stock: Bring 1L (4 cups) water to the boil in a large saucepan. Add the stock powder and stir to dissolve. Return to the boil and cook for 3 mins to develop the flavour.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865733/photos/large/70085_3-5eb138f05480588efe63221d97781f57.jpeg"
    },
    {
      "text": "Cook dumplings: Add the pak choy stems and dumplings to the stock and cook for 3 mins. Stir in the pak choy leaves and cook for 1 min or until the pak choy leaves are wilted and the dumplings are tender. Remove the pan from the heat. Taste the soup, then season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865734/photos/large/70085_4-fa163597ab92229776fdd0cf9a97a58e.jpeg"
    },
    {
      "text": "Serve up: Drain the radish, reserving the pickling liquid. Divide the dumplings among bowls (see Kitchen 101), then ladle over the soup. Top with the pickled radish, peanuts and chilli flakes, if using. Drizzle with the sesame oil and a little reserved pickling liquid and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865735/photos/large/70085_5-b34e10913ac2eed515ba98f10f31502d.jpeg"
    },
    {
      "text": "Kitchen 101: Handle the cooked dumplings with love and care to ensure they don't break up or burst open.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/865736/photos/large/70085_6-4dca55f2339f3ffdf8a3619fd402b041.jpeg"
    }
  ]
}

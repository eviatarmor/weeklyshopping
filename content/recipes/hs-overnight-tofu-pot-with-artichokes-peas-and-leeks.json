  "steps": [
    {
      "text": "Cut the onions into thick slices, place in a bowl, pour over the oil and toss. Use them to line the base of a 26 cm jachnun pot (or any ovenproof pot)."
    },
    {
      "text": "Layer the ingredients on top: peas, artichoke hearts, peeled and roughly chopped kohlrabi, leeks cut into 2 cm pieces, whole mushrooms and sliced tofu."
    },
    {
      "text": "Soak the kombu in warm water (about 60°C) for 20 minutes, then strain out the kombu. Add the soy sauce, pomegranate molasses, pepper, salt and coconut oil. Stir and pour into the pot."
    },
    {
      "text": "Cover the pot and bake in an oven preheated to 100-110°C overnight (at least 8 hours)."
    }
  ]

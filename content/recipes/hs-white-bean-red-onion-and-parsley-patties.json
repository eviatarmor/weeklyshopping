  "steps": [
    {
      "text": "Mash the beans with a fork, add the onion, garlic, parsley, chilli, salt and pepper and mix. Adjust the seasoning."
    },
    {
      "text": "Shape into flat round patties 6 to 7 cm across, dip in the beaten egg, then in the breadcrumbs."
    },
    {
      "text": "Heat a non-stick frying pan with a little oil and fry the patties for 2 minutes on each side until golden. Transfer to paper towel."
    },
    {
      "text": "Serve hot or at room temperature with a salsa of tomatoes seasoned with garlic."
    }
  ]

  "steps": [
    {
      "text": "Preheat oven to 500°F."
    },
    {
      "text": "Drain and rinse chickpeas. Place on paper towels and pat dry. Transfer to a sheet pan."
    },
    {
      "text": "Drizzle chickpeas with oil and season with cumin, salt, and pepper. Toss to coat."
    },
    {
      "text": "Place in the oven and roast until crispy, 15-20 minutes. Stir halfway through cooking time."
    },
    {
      "text": "Peel and mince garlic. In a medium bowl, prepare dressing by whisking together garlic, lemon juice, oil, Dijon, salt, and pepper. Set aside."
    },
    {
      "text": "Wash and dry arugula."
    },
    {
      "text": "Wash and medium dice cucumber. Halve and pit avocados; scoop out and medium dice the flesh."
    },
    {
      "text": "Shred ¼ cup of Parmesan."
    },
    {
      "text": "To serve, arrange a bed of arugula on a plate and top with chickpeas, cucumber, and avocado. Drizzle with dressing and sprinkle with Parmesan. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Place quinoa, almond milk, maple syrup, salt, and cinnamon in a medium saucepan. Bring to a boil over medium-high heat."
    },
    {
      "text": "Once the quinoa mixture comes to a boil, reduce heat to low, allow to cool slightly, and cover with a lid. Cook until most of the liquid is absorbed, about 20 minutes."
    },
    {
      "text": "Add the blueberries and maple syrup to a small saucepan. Heat on medium-high, 3-4 minutes."
    },
    {
      "text": "To serve, divide porridge between bowls, drizzle with more milk, and top with blueberry compote. Enjoy!"
    }
  ]

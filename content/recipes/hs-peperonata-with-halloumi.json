  "steps": [
    {
      "text": "Heat the olive oil in a frying pan and fry the chopped onions for about 3 minutes until golden. Add the finely chopped chilli and the diced capsicums and fry for about 2 minutes."
    },
    {
      "text": "Add the chopped tomatoes, salt, pepper and dried herbs and bring to a gentle boil. Reduce the heat, cover and cook for about 40 minutes until the vegetables are soft. If all the liquid evaporates, add a little water."
    },
    {
      "text": "Add the vinegar and a handful of pitted olives, stir and cook for 2-3 more minutes."
    },
    {
      "text": "Meanwhile, fry the diced halloumi in a pan with a little butter or olive oil until golden."
    },
    {
      "text": "Serve the peperonata with the halloumi cubes and basil leaves."
    }
  ]

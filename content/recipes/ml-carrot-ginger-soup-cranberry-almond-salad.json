  "steps": [
    {
      "text": "Wash and dry the fresh produce. (Skip the spinach if it came pre-washed.)"
    },
    {
      "text": "Peel and roughly chop the carrots and potatoes."
    },
    {
      "text": "Preheat a medium saucepan over medium-high heat."
    },
    {
      "text": "Peel and mince shallot; add to salad bowl."
    },
    {
      "text": "Once the saucepan is hot, add butter and swirl to coat the bottom."
    },
    {
      "text": "Combine the chopped carrots and potatoes, honey, and salt in the saucepan."
    },
    {
      "text": "Peel and mince or grate ginger; add to the saucepan. Reduce to medium heat, cover, and stew for 10 minutes; stirring occasionally."
    },
    {
      "text": "Add broth, bring to a boil; cover and simmer until vegetables are tender, about 12 minutes."
    },
    {
      "text": "In the salad bowl, whisk together olive oil, vinegar, honey, sesame seeds, salt, and pepper."
    },
    {
      "text": "Using an immersion (hand) blender, purée the soup until smooth."
    },
    {
      "text": "Measure out cranberries and almonds."
    },
    {
      "text": "Shave the leaves off parsley stems; discard the stems and mince the leaves."
    },
    {
      "text": "Add the spinach to the bowl with the dressing. Add ¾ of the parsley, the cranberries, and almonds; toss to combine."
    },
    {
      "text": "To serve, pour soup into a bowl, garnish with remaining parsley and arrange salad on the side. Enjoy!"
    }
  ]

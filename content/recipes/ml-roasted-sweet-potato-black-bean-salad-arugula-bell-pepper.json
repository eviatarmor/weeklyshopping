  "steps": [
    {
      "text": "Preheat oven to 450°F."
    },
    {
      "text": "Wash, peel, and medium dice potatoes. Transfer to a baking sheet pan. Drizzle with olive oil and season with salt and pepper; toss to coat."
    },
    {
      "text": "Place in the oven and roast until tender, 15-20 minutes."
    },
    {
      "text": "Drain and rinse beans. Place on paper towels and pat dry."
    },
    {
      "text": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, lime juice, olive oil, vinegar, Dijon, honey, cumin, salt, and pepper."
    },
    {
      "text": "Wash and dry arugula."
    },
    {
      "text": "Wash, seed, and medium dice bell peppers."
    },
    {
      "text": "To serve, arrange a bed of arugula on a plate, top with potatoes, beans, and bell pepper. Drizzle with dressing and enjoy!"
    }
  ]

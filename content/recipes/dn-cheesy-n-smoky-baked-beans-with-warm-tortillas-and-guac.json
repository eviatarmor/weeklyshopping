  "steps": [
    {
      "text": "Prep ingredients: Thinly slice the capsicum. Crush or finely chop the garlic. Drain and rinse the beans. Preheat the grill to high.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108914/photos/large/515205_1-8158fcf9a89688f5d7cbbb3a5f56de86.jpeg"
    },
    {
      "text": "Cook capsicum: Heat 2 tsp olive oil in a medium ovenproof frypan over medium-high heat. Cook the capsicum, stirring occasionally, for 4-5 mins until softened and slightly charred. Reduce the heat to medium. Add the garlic and chipotle (see Cooking tip) and cook for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108918/photos/large/515205_2-850f5fbc8cd6dd7c50e02cbe4a9f9753.jpeg"
    },
    {
      "text": "Simmer bean mixture: Stir the beans, passata, 1 tsp sugar and 60ml (¼ cup) water into the capsicum mixture. Season with salt and pepper. Simmer for 3-4 mins until slightly reduced.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108919/photos/large/515205_3-2c58eb29d3998115e8ac9b804a063ea5.jpeg"
    },
    {
      "text": "Top with cheese and grill: Scatter the cheese over the bean mixture and grill for 5 mins or until the cheese is golden and melted.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108922/photos/large/515205_4-67748553711fa9d215a8955141720ff9.jpeg"
    },
    {
      "text": "Warm tortillas and serve: Put the tortillas on a plate, slightly overlapping, and microwave for 30 secs or until warmed through. Serve the cheesy beans with the guacamole and tortillas. Enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108925/photos/large/515205_5-5ee6b0c70f3ef80250ea13bfc891742f.jpeg"
    },
    {
      "text": "Make it herby: If you have some on hand, scatter over a handful of coriander for a burst of freshness.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/4108927/photos/large/515205_6-6008943387a372362a097cc2b5e7fe2e.jpeg"
    }
  ]
}

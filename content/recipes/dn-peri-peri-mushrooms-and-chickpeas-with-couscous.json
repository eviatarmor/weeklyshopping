  "steps": [
    {
      "text": "Prep ingredients: Cut the mushrooms into 1cm-thick slices. Trim the spring onion, then thinly slice. Thinly slice 1 garlic clove. Drain and rinse the chickpeas.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133584/photos/large/prep_ingredients-6cdca4925958c1d2fac2b5cb7dfda872.jpeg"
    },
    {
      "text": "Cook couscous: Put the couscous in a large heatproof bowl, pour over 180ml (¾ cup) boiling water and cover with a plate. Stand for 5 mins or until the water is absorbed. Fluff the grains with a fork and season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133585/photos/large/cook_couscous-c6ec11dead3746199246cf09e017f16a.jpeg"
    },
    {
      "text": "Brown mushrooms: Meanwhile, heat 3 tsp olive oil in a medium deep frypan over medium-high heat. Cook the mushrooms and garlic, stirring, for 3-4 mins until browned.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133586/photos/large/brown_mushrooms-ef25de1a9eceae9bd80fa63615648bb8.jpeg"
    },
    {
      "text": "Simmer veggies: Add the chickpeas, tomatoes, 2 tsp peri peri seasoning, 60ml (¼ cup) water, 1 tbs tomato paste and 1 tsp sugar to the pan. Bring to the boil. Reduce the heat to medium and cook, stirring occasionally, for 10-12 mins until thickened. Remove the pan from the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133587/photos/large/simmer_dish-371761a97c062525441f6d7ef55db8b4.jpeg"
    },
    {
      "text": "Serve up: Stir 1 tsp red wine vinegar and half the spring onion into the chickpea mixture. Taste, then season with salt and pepper. Divide the couscous and chickpea mixture among bowls. Scatter over the remaining spring onion and enjoy.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133588/photos/large/finish_and_serve_up-6566b4c771d4e96daf6843db1229e8fe.jpeg"
    },
    {
      "text": "Make it yours: Cool things down with a dollop of creamy Greek yoghurt, then scatter over some coriander leaves for a burst of freshness.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133589/photos/large/make_it_yours-f0553935fe6de8b7b2807cbbde011c9c.jpeg"
    }
  ]
}

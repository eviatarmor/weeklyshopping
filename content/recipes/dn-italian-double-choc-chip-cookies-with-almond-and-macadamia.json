  "steps": [
    {
      "text": "Prep ingredients: Preheat the oven to 180C. Line a large oven tray with baking paper. Roughly chop the macadamias. Roughly chop half the dark chocolate. Melt 20g butter.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232230/photos/large/prep_ingredients-f941611790f7871150806e9d31cddcb4.jpeg"
    },
    {
      "text": "Make dough: Put the almond meal, maple syrup, vanilla bean paste, melted butter and 60ml (¼ cup) olive oil in a large bowl and stir well to combine. Add the macadamias, white chocolate and unchopped dark chocolate and stir to combine (the cookie dough will be moist and sticky).",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232231/photos/large/make_dough-af917ef11b354992142a7ee0eaf144c6.jpeg"
    },
    {
      "text": "Shape cookies: Using damp hands, roll heaped tablespoons of cookie dough into 8 equal balls. Put on the lined tray, leaving a 3cm gap between them, and flatten slightly.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232232/photos/large/shape_cookies-b31da6897c9b5157b1e474dd3f62fed4.jpeg"
    },
    {
      "text": "Decorate cookies: Scatter the chopped dark chocolate over the tops of the cookies and lightly press in.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232233/photos/large/decorate_cookies-5fd3c7d4200d51f809ed92f3f2f8152b.jpeg"
    },
    {
      "text": "Bake cookies: Bake the cookies for 15 mins or until light golden and just cooked through (see Make it yours). Cool on the tray, then enjoy. Store any leftover cookies in an airtight container for up to 5 days.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232234/photos/large/bake_cookies-d7f44894ba3de9759566eba09b7ebb62.jpeg"
    },
    {
      "text": "Make it yours: If you prefer a firmer cookie, bake them for an extra 2-3 mins until darker golden in colour.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/232235/photos/large/make_it_yours-c7234861f20c31a8fb19c1e2aa8a7d31.jpeg"
    }
  ]
}

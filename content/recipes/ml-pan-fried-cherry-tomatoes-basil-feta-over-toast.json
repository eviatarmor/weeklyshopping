  "steps": [
    {
      "text": "Peel and thinly slice shallots into rings."
    },
    {
      "text": "Preheat a large nonstick skillet over medium heat."
    },
    {
      "text": "Peel and mince garlic."
    },
    {
      "text": "Once the skillet is hot, add butter and swirl to coat the bottom. Add the shallots and cook, stirring often, until soft and caramelized, 3-4 minutes."
    },
    {
      "text": "Meanwhile, wash and dry the tomatoes; cut in half crosswise."
    },
    {
      "text": "Add tomatoes, garlic, and spices to the skillet. Cook, stirring often, until tomatoes begin to soften and juices have thickened, 4-5 minutes."
    },
    {
      "text": "Toast the bread."
    },
    {
      "text": "Wash and dry basil. Pick leaves off the stems, roll up crosswise, and thinly slice into ribbons."
    },
    {
      "text": "Add basil to the skillet and stir to combine; remove from the heat."
    },
    {
      "text": "To serve, divide toast between plates. Spoon warm tomato mixture over the toast and top with feta. Enjoy!"
    }
  ]

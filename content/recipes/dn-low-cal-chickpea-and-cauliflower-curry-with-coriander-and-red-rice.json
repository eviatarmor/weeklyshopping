  "steps": [
    {
      "text": "Cook rice: Fill a medium saucepan three-quarters full with water and bring to the boil. Add the rice and cook for 25 mins or until tender. Drain.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303684/photos/large/cook_rice-fbca72f1538463bf47c9780786fe29ad.jpeg"
    },
    {
      "text": "Prep ingredients: Meanwhile, cut the cauliflower into small florets. Reserve half the coriander sprigs, then finely chop the remaining leaves and stems, keeping them separate. Crush or finely chop 2 garlic cloves. Drain and rinse the chickpeas.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303685/photos/large/prep_ingredients-c0377c9c55a94828daca0fd965f59c76.jpeg"
    },
    {
      "text": "Cook aromatics: Heat 1 tbs vegetable oil in a medium deep frypan over medium heat. Cook the cauliflower, coriander stems, garlic and masala seasoning, stirring, for 2 mins or until fragrant. Season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303686/photos/large/cook_aromatics-4c11e5d1ce9419722b95af7ed8d019db.jpeg"
    },
    {
      "text": "Simmer curry: Add the tomatoes, chickpeas, 1 tsp sugar and 125ml (½ cup) water to the cauliflower mixture and bring to the boil. Reduce the heat to medium-low, cover and cook, stirring occasionally, for 15 mins or until the sauce is thickened. Stir in the chopped coriander leaves. Taste, then season with salt and pepper. Remove the pan from the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303687/photos/large/simmer_curry-993d26d20181aa0bc24bbf3e567f1178.jpeg"
    },
    {
      "text": "Serve up: Divide the rice and curry among bowls. Top with the reserved coriander sprigs and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303688/photos/large/serve_up-d3e59d309d6f4904aa6b0730831dfca2.jpeg"
    },
    {
      "text": "Make it yours: If you like your curries with a kick of heat, scatter over chilli flakes or sliced fresh chilli to serve.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/303689/photos/large/make_it_yours-c02aac9419a13fb09e81f96128f314a5.jpeg"
    }
  ]
}

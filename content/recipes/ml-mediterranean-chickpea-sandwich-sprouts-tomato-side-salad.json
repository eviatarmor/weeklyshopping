  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Zest and juice lemon into a medium bowl."
    },
    {
      "text": "Peel and mince garlic. Add to the bowl with the lemon along with mayo, Dijon, and spices. Whisk until smooth."
    },
    {
      "text": "Drain and rinse chickpeas; add to the bowl with the mayo dressing. Using a fork or potato masher, roughly mash chickpeas until semi-smooth."
    },
    {
      "text": "Roughly chop sun-dried tomatoes and olives. Add both to the bowl."
    },
    {
      "text": "Trim and cut green onions crosswise into thin pieces. Add to the bowl, stir to combine the chickpea salad, and set aside."
    },
    {
      "text": "Place oil, vinegar, and spices in a large bowl. Whisk to combine the dressing."
    },
    {
      "text": "Drain and roughly chop artichokes. Add to the bowl with the dressing."
    },
    {
      "text": "Trim and medium dice cucumber. Add to the bowl."
    },
    {
      "text": "Chop or tear lettuce into bite-sized pieces. Add to the bowl and toss to combine the salad. Set aside."
    },
    {
      "text": "Slice tomatoes into thin rounds."
    },
    {
      "text": "Toast bread if desired."
    },
    {
      "text": "Divide the chickpea salad between half of the slices and spread out in an even layer. Layer with tomato and sprouts, then close sandwiches with remaining slices of bread."
    },
    {
      "text": "Slice sandwiches in half and divide between plates. Serve with salad on the side and enjoy!"
    }
  ]
}

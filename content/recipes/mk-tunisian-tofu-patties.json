  "steps": [
    {
      "text": "Coarsely grate the tofu. Finely chop the potato, onion, spring onion (green part only), herbs and celery, and crush the garlic."
    },
    {
      "text": "In a large bowl combine the tofu, potato, onion and garlic. Add the spring onion, herbs, spices and olive oil and knead into an even mixture."
    },
    {
      "text": "Add the breadcrumbs and lentil flour and mix well. Cover and rest the mixture for about 10 minutes."
    },
    {
      "text": "Heat vegetable oil in a large frying pan over medium heat."
    },
    {
      "text": "With slightly wet hands, shape the mixture into small patties and flatten them lightly. Place in the pan."
    },
    {
      "text": "Fry for about 4 minutes on each side, until golden. Transfer the patties to a cooling rack."
    }
  ]

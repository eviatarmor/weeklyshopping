  "steps": [
    {
      "text": "In a wide, deep bowl, beat the eggs with the chopped parsley, coriander and spring onion greens, salt, pepper, cumin and turmeric."
    },
    {
      "text": "Grate the potatoes, sweet potato, onions and zucchini on the large holes of a box grater. Squeeze the vegetables out well between your hands and add to the egg mixture. Add the self-raising flour and mix, cover the bowl with plastic wrap and refrigerate for 2 hours."
    },
    {
      "text": "Heat 1 cm of oil in a non-stick pan. Take the mixture from the fridge and form flattened patties in the size you like. Fry for about 4 minutes on each side over medium heat and transfer to a plate lined with baking paper."
    }
  ]

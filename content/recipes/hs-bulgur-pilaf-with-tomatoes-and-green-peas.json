  "steps": [
    {
      "text": "Heat the oil in a wide pot. Add the chopped onion and fry for 6 minutes until lightly golden. Add the garlic, tomato paste and paprika and stir."
    },
    {
      "text": "Add the grated tomatoes, water (or stock), salt and pepper, stir and bring to the boil."
    },
    {
      "text": "Add the bulgur and bring to the boil. Cover, reduce the heat and cook for about 30 minutes until the water is absorbed."
    },
    {
      "text": "Fluff the grains gently with a fork, add the peas and stir. Cover and cook for another 5 minutes. Turn off the heat and wait 10 minutes before lifting the lid."
    },
    {
      "text": "Meanwhile, mix the yoghurt with the crushed garlic, lemon zest, finely chopped mint and salt. Taste and adjust. Serve alongside the hot pilaf."
    }
  ]

  "steps": [
    {
      "text": "Preheat a large pot over medium heat."
    },
    {
      "text": "While the pot heats up, drain and rinse beans in a colander; set aside to drain further."
    },
    {
      "text": "Once the pot is hot, add oil and swirl to coat the bottom. Add mushrooms and cook, stirring occasionally, until softened, about 3 minutes."
    },
    {
      "text": "Add beans, broth, Alfredo sauce, and spices to the pot. Stir to combine the soup and bring to a boil over medium-high heat."
    },
    {
      "text": "Once boiling, add kale to the pot in handfuls, waiting for the kale to wilt slightly before adding the next handful. Reduce heat to low and continue to cook until beans and kale are tender, about 5 minutes."
    },
    {
      "text": "Meanwhile, wash, dry, and shave parsley leaves off the stems; discard stems and mince the leaves."
    },
    {
      "text": "When the soup is done, remove from heat, add parsley, and stir to combine."
    },
    {
      "text": "To serve, divide soup between bowls. Top with pine nuts and enjoy!"
    }
  ]

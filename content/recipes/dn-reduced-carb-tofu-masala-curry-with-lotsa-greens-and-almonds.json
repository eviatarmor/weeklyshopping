  "steps": [
    {
      "text": "Prep ingredients: Thinly slice the onion. Crush or finely chop the garlic. Tear the kale leaves into small pieces, discarding the stems. Quarter the tofu pieces.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328238/photos/large/283925_1-8158fcf9a89688f5d7cbbb3a5f56de86.jpeg"
    },
    {
      "text": "Start curry: Heat 2 tsp vegetable oil in a medium deep frypan over medium heat. Cook the onion, stirring, for 5 mins or until soft. Add the garlic, masala seasoning and half the tomato paste and cook, stirring, for 1-2 mins until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328239/photos/large/283925_2-850f5fbc8cd6dd7c50e02cbe4a9f9753.jpeg"
    },
    {
      "text": "Simmer curry: Stir the tofu, kale, coconut milk, peas and 250ml (1 cup) water into the onion mixture and bring to a simmer over medium heat. Cover and cook for 6-7 mins until the vegetables are tender.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328240/photos/large/283925_3-2c58eb29d3998115e8ac9b804a063ea5.jpeg"
    },
    {
      "text": "Toast almonds: Meanwhile, put the almonds in a cold small frypan over medium heat. Toast, tossing, for 3-4 mins until evenly golden. Remove from the pan.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328241/photos/large/283925_4-67748553711fa9d215a8955141720ff9.jpeg"
    },
    {
      "text": "Serve up: Remove the lid and cook the curry for a further 1-2 mins until slightly thickened. Stir in 1 tsp sugar and 1 tsp white vinegar. Taste, then season with salt and pepper. Divide the curry among bowls and scatter with the almonds. Enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328242/photos/large/283925_5-5ee6b0c70f3ef80250ea13bfc891742f.jpeg"
    },
    {
      "text": "Make it herby: If you have some on hand, scatter over a handful of coriander leaves for a burst of freshness.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2328243/photos/large/283925_6-6008943387a372362a097cc2b5e7fe2e.jpeg"
    }
  ]
}

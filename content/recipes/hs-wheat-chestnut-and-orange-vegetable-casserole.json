  "steps": [
    {
      "text": "Slice the onions. Heat the oil in a wide ovenproof pot and fry the onions for 5 minutes until golden. Add the wheat, pumpkin (cut into 3 cm cubes), sliced carrots and whole peeled garlic and saute for another 4 minutes, stirring. Season generously with salt and pepper."
    },
    {
      "text": "Preheat the oven to 140°C."
    },
    {
      "text": "Add the chestnuts, silan and 500 ml of water to the pot and bring to the boil. Cover and boil for 15 minutes. Adjust the seasoning."
    },
    {
      "text": "Bake for at least 3 hours, or overnight. After 2 hours check the liquid level, which should come up to half the height of the contents. Add water if needed (up to 1 cup)."
    }
  ]

  "steps": [
    {
      "text": "Fill a large pot halfway with water, cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes."
    },
    {
      "text": "Meanwhile, peel and mince the garlic and shallots; place both in a large bowl."
    },
    {
      "text": "Add oil, vinegar, and spices to the bowl; whisk to combine the dressing."
    },
    {
      "text": "Drain and thinly slice artichokes; add to the bowl with the dressing."
    },
    {
      "text": "Halve olives lengthwise and add to the bowl."
    },
    {
      "text": "Roughly chop capers and add to the bowl."
    },
    {
      "text": "Wash, dry, and halve tomatoes; add to the bowl."
    },
    {
      "text": "Wash and dry parsley. Shave leaves off the stems; discard the stems and mince the leaves. Add to the bowl and stir to combine."
    },
    {
      "text": "Drain pasta in a colander and rinse under cold water; add to the bowl."
    },
    {
      "text": "Drain and rinse the beans; add to the bowl. Gently toss the salad to combine."
    },
    {
      "text": "To serve, divide pasta salad between bowls or plates. Garnish with pine nuts and enjoy!"
    }
  ]

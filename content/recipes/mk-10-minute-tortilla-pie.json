  ],
  "steps": [
    {
      "text": "Grease the tin with a little olive oil and preheat the oven or toaster oven to 180°C."
    },
    {
      "text": "Arrange the tortillas to cover the whole tin, with the edges poking out."
    },
    {
      "text": "Crack the eggs in and mix with a fork. Add the cottage cheese and mix."
    },
    {
      "text": "Add the remaining ingredients except the mozzarella and mix with a fork."
    },
    {
      "text": "Sprinkle over the mozzarella."
    },
    {
      "text": "Bake in the oven at 180°C for about 15 minutes."
    }
  ]

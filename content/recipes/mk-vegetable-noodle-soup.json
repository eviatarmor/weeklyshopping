  "steps": [
    {
      "text": "Fry the diced onion and garlic in a pot until gently translucent, about 2 minutes."
    },
    {
      "text": "Add the cauliflower and broccoli florets, bay leaves and chilli, then the stock (or water). Bring to the boil."
    },
    {
      "text": "Reduce the heat, cover the pot and cook for a quarter of an hour."
    },
    {
      "text": "Add the diced zucchini and finely chopped parsley, season with salt and cook for another quarter of an hour, until the vegetables are tender but still have a bite."
    },
    {
      "text": "Cook the noodles separately and add them to the soup."
    }
  ]

  "steps": [
    {
      "text": "Finely chop the ginger and chilli, and cut the sweet potatoes into 3 cm cubes. Break the cauliflower into florets."
    },
    {
      "text": "Heat the ghee, mustard seeds, cumin seeds, ginger and chilli in a medium pot over medium heat until fragrant. Add the cauliflower and sweet potato and fry for 2 to 3 minutes."
    },
    {
      "text": "Add the turmeric, curry powder, garam masala and 1 cup of water. Cover and cook for about 15 minutes, or until the vegetables are just tender."
    },
    {
      "text": "Add the peas, coconut cream and salt and cook for another 5 minutes."
    }
  ]

  "steps": [
    {
      "text": "Put the flaxseed in a small bowl, add just enough water to cover and soak for 30 minutes."
    },
    {
      "text": "Preheat the oven to 180°C and line a baking tray with baking paper."
    },
    {
      "text": "Blend the flaxseed and its soaking water with the remaining ingredients in a blender in a few pulses until combined."
    },
    {
      "text": "Shape into flat patties 7-8 cm wide and place on the tray."
    },
    {
      "text": "Bake for about 35 minutes or until lightly golden. Serve hot or at room temperature."
    },
    {
      "text": "Keep in a container in the fridge for up to 4 days."
    }
  ]

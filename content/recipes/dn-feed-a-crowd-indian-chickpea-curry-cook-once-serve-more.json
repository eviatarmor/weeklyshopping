  "steps": [
    {
      "text": "Prep ingredients: Peel the pumpkin and cut into 2cm chunks. Trim the beans and halve on an angle. Crush or finely chop 2 garlic cloves. Drain and rinse the chickpeas.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467070/photos/large/72047_1-b998e57c69370c7f769e764e5aa9f750.jpeg"
    },
    {
      "text": "Cook rice: Fill a medium saucepan three-quarters full with water and bring to the boil. Add the rice and cook for 12 mins or until tender. Drain.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467071/photos/large/72047_2-18048c0550375edfe2fd13604edb2803.jpeg"
    },
    {
      "text": "Brown pumpkin: Meanwhile, heat 1 tbs vegetable oil in a large deep frypan over medium heat. Cook the pumpkin, stirring, for 3-4 mins until golden. Add the masala seasoning, garlic and tomato paste and cook, stirring, for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467072/photos/large/72047_3-006331c1b939d214c15b8279657a8624.jpeg"
    },
    {
      "text": "Simmer curry: Add the chickpeas, coconut milk and 500ml (2 cups) water to the pumpkin mixture, season with salt and pepper and stir to combine. Bring to the boil, then reduce the heat to medium-low and cook, covered, stirring occasionally, for 12-15 mins until the pumpkin is just tender.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467073/photos/large/72047_4-523fceba5d991ea7fd5572c5b3416403.jpeg"
    },
    {
      "text": "Serve up: Add the beans to the curry and cook, uncovered, for 3-5 mins until the beans and pumpkin are tender. Taste, then season with salt and pepper. Divide the rice and curry among bowls and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467074/photos/large/72047_5-57c581c465eeebd67812e8aee20f00ad.jpeg"
    },
    {
      "text": "Feed A Crowd: Like it herby? If you have some on hand, scatter over a handful of coriander for a burst of freshness.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/1467075/photos/large/72047_6-77641f87e3d025bbc0e6cff111255b78.jpeg"
    }
  ]
}

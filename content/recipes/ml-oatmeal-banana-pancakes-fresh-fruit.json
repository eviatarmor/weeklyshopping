  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Preheat a large skillet over medium heat."
    },
    {
      "text": "Add the bananas, oats, milk, and cinnamon to the blender. Purée for 30 seconds, until smooth."
    },
    {
      "text": "Once the skillet is hot, add butter and swirl to coat the bottom."
    },
    {
      "text": "Using a ¼-cup measure, pour the batter into the skillet. Cook for 1-2 minutes on each side, until browned. Work in batches if necessary."
    },
    {
      "text": "Slice the strawberries in half. Peel and slice the kiwis."
    },
    {
      "text": "Divide the pancakes, strawberries, kiwis, and blueberries between plates. Top with maple syrup and enjoy!"
    }

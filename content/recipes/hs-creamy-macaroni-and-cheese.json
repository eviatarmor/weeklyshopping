  "steps": [
    {
      "text": "Preheat the oven to 190°C. Grease a baking dish with 1 tbsp of the butter."
    },
    {
      "text": "Blend the cottage cheese, milk, mustard powder, cayenne, nutmeg, salt and pepper in a blender. Add the dry pasta and 400 g of the grated cheddar, mix, spread in the dish and cover with foil."
    },
    {
      "text": "Bake for 30 minutes."
    },
    {
      "text": "Remove the foil, sprinkle over the remaining cheese and bake for another 30 minutes until browned."
    },
    {
      "text": "Cool for 15 minutes before serving."
    }
  ]

  "steps": [
    {
      "text": "Place oil, vinegar, salt, and pepper in a small bowl. Stir to combine the dressing."
    },
    {
      "text": "Mince walnuts, olives, and sun-dried tomatoes. Add all three to the bowl with the dressing and stir to combine the tapenade. Set aside."
    },
    {
      "text": "Wash, dry, and halve tomatoes lengthwise, then slice crosswise into thin half-moons."
    },
    {
      "text": "Wash, dry, halve, and pit avocados; using a spoon, scoop out the flesh and slice lengthwise into thin pieces."
    },
    {
      "text": "To serve, divide tomato and avocado slices between plates, then spoon tapenade over top. Enjoy!"
    }
  ]

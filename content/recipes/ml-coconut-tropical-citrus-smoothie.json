  "steps": [
    {
      "text": "This recipe will make about 8 cups. Work in batches to best fit your blender."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Peel the oranges and cut into quarters; place in blender."
    },
    {
      "text": "Cut skin off pineapple, core, and cut into large pieces; place in blender."
    },
    {
      "text": "Add the mango, coconut milk, and 4 ice cubes to the blender."
    },
    {
      "text": "Blend on high speed for several minutes until smooth."
    },
    {
      "text": "Pour the smoothie into glasses and enjoy!"
    }
  ]

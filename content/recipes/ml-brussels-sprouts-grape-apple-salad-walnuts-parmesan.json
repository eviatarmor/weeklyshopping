  "steps": [
    {
      "text": "In a large salad bowl, prepare dressing by whisking together lemon juice, olive oil, vinegar, maple syrup, salt, and pepper."
    },
    {
      "text": "Wash brussels sprouts and trim rough ends. Shred by slicing thinly or using a mandoline slicer; transfer to salad bowl and toss with dressing."
    },
    {
      "text": "Wash grapes and apples. Halve and add grapes to salad bowl. Core, medium dice, and add apples to salad bowl."
    },
    {
      "text": "Roughly chop walnuts; add to salad bowl. Grate ½ cup of Parmesan; add to salad bowl."
    },
    {
      "text": "Toss salad until well combined."
    },
    {
      "text": "Serve salad on a plate and enjoy!"
    }
  ]

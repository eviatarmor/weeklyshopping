  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Crumble the tofu (a food processor is easiest, but do not blend it completely). In the same processor, chop the herbs and the tomato."
    },
    {
      "text": "Mix all the patty ingredients in a bowl and shape into patties with oiled hands. Arrange on a tray lined with baking paper and bake for about 10 minutes."
    },
    {
      "text": "Turn the patties over and bake for another 10 minutes."
    },
    {
      "text": "Mix the sauce ingredients in a baking dish."
    },
    {
      "text": "Transfer the patties to the dish with the sauce and bake for another 10 minutes (the sauce will not cover the patties, which is fine)."
    }
  ]
}

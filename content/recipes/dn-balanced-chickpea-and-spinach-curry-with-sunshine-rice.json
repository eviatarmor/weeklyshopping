  "steps": [
    {
      "text": "Cook rice: Fill a medium saucepan three-quarters full with water and bring to the boil. Add the rice and 1 tsp turmeric and cook for 25 mins or until tender. Drain.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287712/photos/large/cook_rice-df3f154ee7620d2c10f37fa2ca8bcc64.jpeg"
    },
    {
      "text": "Prep ingredients: Meanwhile, thinly slice the onion into rings. Halve the tomatoes, reserving ¼ cup to serve. Coarsely chop the spinach leaves (see Kitchen 101), discarding the stems. Drain and rinse the chickpeas.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287713/photos/large/prep_ingredients-f040198c891ec5d39aa889d58ef334bc.jpeg"
    },
    {
      "text": "Cook onion and aromatics: Heat 2 tsp vegetable oil in a medium deep frypan over medium heat. Cook the onion, stirring, for 3-4 mins until softened. Add the masala seasoning and ½ tsp turmeric and cook, stirring, for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287714/photos/large/cook_onion_and_aromatics-04b23c1bb44995a308126e502f854cef.jpeg"
    },
    {
      "text": "Simmer curry: Add the tomatoes, chickpeas, 1 tbs tomato paste and 250ml (1 cup) boiling water to the onion mixture, then season with salt. Bring to the boil, then reduce the heat to medium and cook, covered, for 15 mins or until the tomatoes are softened. Stir in the spinach until wilted. Remove the pan from the heat. Taste, then season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287715/photos/large/simmer_curry-7d383d11fde376f95f9d5b361e435ead.jpeg"
    },
    {
      "text": "Serve up: Divide the rice and chickpea curry among bowls and top with the reserved tomatoes. Enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287716/photos/large/serve_up-671d13e7528a5c74dc8e31db8c46cccb.jpeg"
    },
    {
      "text": "Kitchen 101: Wash the spinach really well to remove any hidden dirt.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/287717/photos/large/kitchen_101-a2f3f16156e3116a0fd62ec1d9840ca2.jpeg"
    }
  ]
}

  ],
  "steps": [
    {
      "text": "Preheat oven to 400°F."
    },
    {
      "text": "Add oats to a large mixing bowl."
    },
    {
      "text": "Roughly chop nuts and add to the bowl."
    },
    {
      "text": "Melt coconut oil in a medium saucepan. Add maple syrup, salt, cocoa powder, and cinnamon; whisk to combine."
    },
    {
      "text": "Pour oil mixture over oats and nuts and stir to coat."
    },
    {
      "text": "Spread out on a baking sheet lined with parchment paper and bake for 6-8 minutes, stirring halfway through cooking. Watch carefully as the nuts can burn easily."
    },
    {
      "text": "Peel the bananas and slice."
    },
    {
      "text": "Spoon yogurt into bowls and top with granola and bananas. Enjoy!"
    }
  ]

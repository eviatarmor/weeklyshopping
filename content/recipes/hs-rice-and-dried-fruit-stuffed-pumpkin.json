  "steps": [
    {
      "text": "Cut a lid from the top of the pumpkin, scoop out the seeds and rinse well."
    },
    {
      "text": "Bring plenty of salted water to the boil in a medium pot, add the rice and cook for 9 minutes. Drain and transfer to a bowl."
    },
    {
      "text": "Add the honey, melted butter, chopped dried fruit (raisins, prunes, figs, apricots), almonds and spices to the bowl and mix."
    },
    {
      "text": "Preheat the oven to 200°C. Fill the pumpkin with the rice, put the lid on top, wrap in foil and bake for about 1 hour until the pumpkin is tender."
    }
  ]

  "steps": [
    {
      "text": "Cut the kohlrabi and sweet potato into large cubes, the cabbage into quarters, the carrot into 3 cm slices and the onion into sixths. Mix with the whole garlic, whole small zucchini, chestnuts, tea, olive oil, silan, thyme, salt and pepper, and place in an ovenproof dish or cast iron pot lined with baking paper."
    },
    {
      "text": "Cover the dish or pot with aluminium foil and bake in an oven preheated to 200°C for 1 hour."
    },
    {
      "text": "Remove the foil and continue baking until the vegetables are browned."
    }
  ]

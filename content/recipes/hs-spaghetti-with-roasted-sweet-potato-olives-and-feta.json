  "steps": [
    {
      "text": "Preheat the oven to 250°C. Spread the diced sweet potato on a tray lined with baking paper and roast for 10-12 minutes until tender. Drizzle with 1 tbsp olive oil and the thyme."
    },
    {
      "text": "Cook the spaghetti according to the packet instructions, keeping a little of the cooking water for the sauce."
    },
    {
      "text": "Heat the remaining olive oil in a frying pan, add the garlic, halved olives and roasted sweet potato and fry lightly."
    },
    {
      "text": "Add the pasta with a little of the cooking water to the pan. Stir, season with the sun-dried tomato paste, salt, pepper and chilli flakes and sprinkle the crumbled cheese on top."
    },
    {
      "text": "Serve in bowls and garnish with a few rocket leaves."
    }
  ]

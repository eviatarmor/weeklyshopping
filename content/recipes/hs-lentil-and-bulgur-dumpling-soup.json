  "steps": [
    {
      "text": "Cover the bulgur with hot water and soak for about half an hour. Drain off the liquid, add the flour and spices and mix. Add a little water, stirring, only until you have a slightly sticky mixture."
    },
    {
      "text": "Shape the mixture into small dough balls and set aside."
    },
    {
      "text": "Put the lentils in a pot with plenty of water and bring to the boil."
    },
    {
      "text": "Meanwhile, heat the oil in a pan and fry the chopped onion until dark brown."
    },
    {
      "text": "Add the fried onion and bulgur dumplings to the lentils and cook the soup for about 40 minutes, until the lentils are soft."
    }
  ]

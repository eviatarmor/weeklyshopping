  "steps": [
    {
      "text": "Prep ingredients: Bring a large saucepan of salted water to the boil for the ravioli. Cut the tomato into 1cm chunks.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242533/photos/large/prep_ingredients-7ffd15f2e8ce6801e437bad38319a8e5.jpeg"
    },
    {
      "text": "Toast almonds: Put the almonds in a cold small frypan over medium heat. Toast, tossing, for 3-4 mins until evenly golden. Remove from the pan.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242534/photos/large/toast_almonds-975593d21dddd89e5b3ee677de0dad1c.jpeg"
    },
    {
      "text": "Cook ravioli: Cook the ravioli in the pan of boiling water for 5 mins or until al dente. Reserve 60ml (¼ cup) cooking water, then drain. Return the ravioli to the pan. Crumble 1 stock cube into the reserved cooking water and stir until dissolved.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242535/photos/large/cook_ravioli-2c3ce0190bc751436203b119e0b8a3ce.jpeg"
    },
    {
      "text": "Add pesto: Add the pesto, stock mixture and 2 tsp olive oil to the ravioli and cook, stirring, over medium-high heat for 2 mins or until coated and warmed through. Remove the pan from the heat. Taste, then season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242536/photos/large/add_pesto-abeb3d87920b91f1c0ce05c3e0e0f58e.jpeg"
    },
    {
      "text": "Serve up: Divide the ravioli among bowls, crumble over the feta, then scatter over the tomato and toasted almonds. Enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242537/photos/large/serve_up-43bd6c9f00d6dd0d84db55cbfab13dbe.jpeg"
    },
    {
      "text": "Make it yours: Have fussy eaters? Combine the tomato, feta and almonds in a bowl, drizzle with a little oil or vinaigrette and serve as a salad on the side.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/242538/photos/large/make_it_yours-e50b3a44c653addb32bd6f462019c15a.jpeg"
    }
  ]
}

  "steps": [
    {
      "text": "Generously oil a hot grill pan and sear the halloumi for 2 minutes on each side, until charred."
    },
    {
      "text": "Whisk all the vinaigrette ingredients together in a bowl."
    },
    {
      "text": "In a large bowl, combine all the salad ingredients except the fried onions and halloumi. Tear the lettuce, slice the cucumbers and avocados and use the peeled pomelo segments."
    },
    {
      "text": "Dress the salad with the vinaigrette, top with the halloumi, sprinkle over the crispy onions and serve immediately."
    }

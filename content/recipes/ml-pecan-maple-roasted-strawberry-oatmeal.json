  "steps": [
    {
      "text": "Preheat oven to 400°F. Line a baking sheet with parchment paper."
    },
    {
      "text": "Wash and dry strawberries; trim stem ends and slice."
    },
    {
      "text": "Transfer strawberries to baking sheet, drizzle with maple syrup, and spread out in a single layer. Roast until softened, 10-13 minutes."
    },
    {
      "text": "Roughly chop pecans."
    },
    {
      "text": "Add salt and water to a medium saucepan and bring to a boil over high heat. Once boiling, stir in oats and reduce heat to medium. Cover and let simmer for 3-5 minutes or until oats reach desired consistency."
    },
    {
      "text": "To serve, divide oats between bowls and top with strawberries, pecans, and milk. Enjoy!"
    }
  ]

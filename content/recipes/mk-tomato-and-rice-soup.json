  "steps": [
    {
      "text": "Heat the oil in a pot and add the finely chopped onion. Fry until translucent."
    },
    {
      "text": "Add the chopped celery and crushed garlic and fry for another minute, stirring."
    },
    {
      "text": "Add the finely grated tomatoes, tomato paste and dried spices and cook for about 5 minutes, stirring."
    },
    {
      "text": "Add the rice and boiling water and stir. Bring to the boil, lower the heat and cover the pot."
    },
    {
      "text": "Cook for about an hour, or until the rice is completely soft. Stir every 15-20 minutes so the rice does not stick to the bottom. The soup is ready when the rice is falling apart from the long cooking."
    },
    {
      "text": "Add the finely chopped coriander and serve."
    }
  ]

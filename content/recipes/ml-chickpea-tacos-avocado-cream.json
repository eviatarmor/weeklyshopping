  "steps": [
    {
      "text": "Drain and rinse the beans in a colander; set aside to drain further."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Seed and small dice the bell peppers; set aside."
    },
    {
      "text": "Peel and small dice onion."
    },
    {
      "text": "Preheat a large skillet over medium-high heat."
    },
    {
      "text": "Peel and mince garlic."
    },
    {
      "text": "Once the skillet is hot, add oil and swirl to coat the bottom."
    },
    {
      "text": "Add the bell peppers, onion, garlic, and chickpeas. Cook until the chickpeas are slightly golden, stirring occasionally, about 3-4 minutes."
    },
    {
      "text": "Add soy sauce, chili powder, and paprika to the chickpeas and sauté for 5-7 more minutes, until golden brown."
    },
    {
      "text": "Add the avocados, water, and salt to a blender. Juice the lime into the blender. Purée until smooth."
    },
    {
      "text": "Wrap the tortillas in damp paper towels and microwave until heated through, 15-30 seconds."
    },
    {
      "text": "To assemble, add the chickpea vegetable mixture to each tortilla. Top with a drizzle of the avocado cream. Enjoy!"
    }
  ]

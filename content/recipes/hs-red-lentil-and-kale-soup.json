  "steps": [
    {
      "text": "Heat a large pot with the oil and butter. Add the chopped onions, garlic, chilli and thyme and fry over medium-low heat for about 5 minutes until the onion softens and turns translucent. Add the chopped carrots and celery and fry for a few minutes until glazed and slightly soft."
    },
    {
      "text": "Add the peeled, chopped pumpkin, chopped kale, lentils and barley, cover with water and bring to the boil. Season with salt and pepper, reduce the heat and simmer gently for about 30 minutes. If the soup is too thick, add a little water."
    },
    {
      "text": "Season with a handful of chopped greens, adjust the seasoning and serve."
    }
  ]

  "steps": [
    {
      "text": "Preheat oven to 425°F."
    },
    {
      "text": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)"
    },
    {
      "text": "Halve and pit the avocado. Slice thinly while still in skin, then scoop out into a small bowl and mash with a fork until smooth."
    },
    {
      "text": "Juice one of the limes into the bowl with the avocado; cut remaining lime into wedges and set aside."
    },
    {
      "text": "Add yogurt, honey, and spices to the bowl; whisk to combine the dressing and set aside."
    },
    {
      "text": "Small dice tomatoes and place in a large bowl."
    },
    {
      "text": "Peel and small dice onion; add to the bowl with the tomatoes."
    },
    {
      "text": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl."
    },
    {
      "text": "Place corn in a colander and run under cold water to thaw. Drain and rinse beans in the colander with the corn; set aside to drain further."
    },
    {
      "text": "Place pitas on a large baking sheet pan and drizzle with oil. Place in the oven and bake until pitas are toasted, 2-3 minutes."
    },
    {
      "text": "Meanwhile, add corn, beans, and mixed greens to the bowl with the tomatoes; toss to combine the salad."
    },
    {
      "text": "Coarsely grate cheddar."
    },
    {
      "text": "To serve, divide pitas between plates, then top with salad, cheese, and dressing. Place lime wedges on the side and enjoy!"
    }
  ]
}

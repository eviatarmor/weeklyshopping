  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Zest and juice lemon into a medium bowl, then add yogurt, sugar, and spices. Whisk to combine the dressing."
    },
    {
      "text": "Trim and small dice celery. Add to the bowl with the dressing."
    },
    {
      "text": "Halve grapes. Add to the bowl."
    },
    {
      "text": "Quarter, core, and small dice apples. Add to the bowl."
    },
    {
      "text": "Place edamame in a colander and rinse under hot, running water (from the tap) to defrost. Add to the bowl and stir to combine the salad."
    },
    {
      "text": "To serve, divide salad between plates or bowls and enjoy!"
    }

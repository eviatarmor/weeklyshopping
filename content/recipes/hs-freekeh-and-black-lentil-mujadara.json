  "steps": [
    {
      "text": "Heat a pot with the olive oil and fry the sliced onions for about 10 minutes until deeply browned, being careful not to burn them. Remove some of the onion and set it aside for garnish."
    },
    {
      "text": "Drain the soaked lentils and add to the pot. Add the freekeh and boiling water and bring to the boil. Season with the cumin, cover and cook for about 30 minutes over low heat until the lentils soften."
    },
    {
      "text": "Season with salt and pepper and cook for 10 more minutes."
    },
    {
      "text": "Sprinkle the fried onion on top and serve hot or lukewarm."
    }
  ]

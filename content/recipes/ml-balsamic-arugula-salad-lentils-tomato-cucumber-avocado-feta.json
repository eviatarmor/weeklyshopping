  "steps": [
    {
      "text": "Peel, halve, and small dice onion. Place in a large bowl."
    },
    {
      "text": "Drain and rinse lentils. Add to the bowl with the onion."
    },
    {
      "text": "Wash and dry the fresh produce. (Skip the arugula if it came pre-washed.)"
    },
    {
      "text": "Halve tomatoes lengthwise and add to the bowl."
    },
    {
      "text": "Trim and small dice cucumber. Add to the bowl."
    },
    {
      "text": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl."
    },
    {
      "text": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl."
    },
    {
      "text": "Add feta and vinaigrette to the bowl, then stir to combine the salad."
    },
    {
      "text": "To serve, divide arugula between plates or bowls; top with the lentil salad. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Heat a deep pan or a wide casserole pot."
    },
    {
      "text": "Chop the onion, carrot, celeriac and Jerusalem artichoke in a food processor or on the coarse side of a grater."
    },
    {
      "text": "Add olive oil and the chopped vegetables to the pan."
    },
    {
      "text": "Chop the mushrooms and add them to the pan. Stir and keep frying."
    },
    {
      "text": "Add the chopped tomatoes, crushed tomatoes, crushed garlic and the beans."
    },
    {
      "text": "Season with salt and pepper and cover. Cook until the flavours come together (if using frozen beans, until the beans soften)."
    }

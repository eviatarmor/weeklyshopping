  "steps": [
    {
      "text": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)"
    },
    {
      "text": "Drain and rinse lentils; set aside to drain further."
    },
    {
      "text": "Place mixed greens and carrots in a large bowl."
    },
    {
      "text": "Trim and halve cucumber lengthwise, then cut crosswise into thin half-moons. Add to the bowl with the mixed greens."
    },
    {
      "text": "Halve tomatoes lengthwise and add to the bowl."
    },
    {
      "text": "Trim, seed, and small dice bell peppers. Add to the bowl."
    },
    {
      "text": "Halve and pit avocados; using a spoon, scoop out the flesh and medium dice. Add to the bowl."
    },
    {
      "text": "Crumble goat cheese. Add to the bowl along with the lentils, almonds, cranberries, and dressing; toss to combine the salad."
    },
    {
      "text": "To serve, divide salad between plates or bowls. Enjoy!"
    }
  ]

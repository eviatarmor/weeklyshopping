  "steps": [
    {
      "text": "Cook the pasta according to the packet instructions until al dente. Drain and set aside."
    },
    {
      "text": "Make a basic bechamel: melt the butter in a pot, add the flour and whisk for a minute or two until golden. Gradually add the milk and cream while whisking so no lumps form. Bring to a gentle simmer and cook until thickened."
    },
    {
      "text": "Lower the heat and gradually add the cheeses, stirring until melted. Season with salt, black pepper, paprika and nutmeg."
    },
    {
      "text": "Mix the pasta with the cheese sauce until well coated and transfer to a medium baking dish."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Make the topping: mix breadcrumbs, melted butter and cheddar in a bowl. Sprinkle over the pasta."
    },
    {
      "text": "Bake for 15 to 20 minutes, until the top is golden."
    }
  ]

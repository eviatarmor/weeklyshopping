  "steps": [
    {
      "text": "Prepare the broccoli: if using fresh, blanch in boiling water for 3-4 minutes and drain. Chop roughly. If using frozen florets, thaw and squeeze out the liquid."
    },
    {
      "text": "Preheat the oven to 180°C and grease a rectangular baking dish."
    },
    {
      "text": "In a bowl, mix the eggs, cottage cheese, sour cream, cheeses, olive oil (or melted butter), flour and baking powder. Season with salt, pepper and crushed garlic."
    },
    {
      "text": "Add the broccoli and mix well."
    },
    {
      "text": "Transfer to the dish, sprinkle a thin layer of breadcrumbs on top and bake for 40-45 minutes, until golden and set."
    },
    {
      "text": "Cool slightly and serve."
    }
  ]

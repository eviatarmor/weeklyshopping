  "steps": [
    {
      "text": "Place the lentils, thyme, sage, whole peeled garlic, onion cut into eighths, carrots cut into 1 cm rounds, deseeded chopped chilli and olive oil in a wide pot. Add water to cover and bring to the boil."
    },
    {
      "text": "Reduce the heat and cook uncovered until the lentils are al dente and most of the liquid has evaporated. You can prepare up to this point ahead of time."
    },
    {
      "text": "Before serving, return the stew to the stove and add salt, pepper and the silverbeet. Cook for about 5 minutes over low heat until the silverbeet softens."
    },
    {
      "text": "Spoon the tahini into 4 deep bowls, top with the stew and serve with a lemon wedge."
    }
  ]

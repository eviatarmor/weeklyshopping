  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Juice lime into a medium bowl."
    },
    {
      "text": "Shave cilantro leaves off the stems; discard stems and mince the leaves. Add to the bowl with the lime juice."
    },
    {
      "text": "Halve and pit avocados; using a spoon, scoop out the flesh and add to the bowl. Season with spices and mash with a fork or potato masher until smooth."
    },
    {
      "text": "Add yogurt to the bowl and stir to combine the avocado-yogurt dip."
    },
    {
      "text": "To serve, divide dip and chips between plates. Enjoy!"
    }
  ]

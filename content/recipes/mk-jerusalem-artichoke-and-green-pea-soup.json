  "steps": [
    {
      "text": "Heat the coconut oil in a medium pot and fry the chopped onion until translucent. Add the cubed Jerusalem artichoke and potatoes, the garlic, the zucchini and the parsley root, and cover with water."
    },
    {
      "text": "Add the oats and coconut milk and season. Bring to the boil, reduce the heat and cook for about 20 minutes, until all the vegetables are soft."
    },
    {
      "text": "Blend with a food processor until smooth and uniform."
    },
    {
      "text": "Put the frozen peas in a sieve and rinse under warm tap water for a minute. Add to the soup and serve."
    }
  ]

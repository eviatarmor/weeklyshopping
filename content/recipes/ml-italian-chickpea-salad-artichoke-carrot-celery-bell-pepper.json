  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Drain and rinse chickpeas; set aside to drain further."
    },
    {
      "text": "Place oil, vinegar, sugar, and spices in a medium bowl. Whisk to combine the dressing."
    },
    {
      "text": "Peel, trim, and small dice carrots. Add to the bowl with the dressing."
    },
    {
      "text": "Trim and small dice celery. Add to the bowl."
    },
    {
      "text": "Trim, seed, and small dice bell pepper. Add to the bowl."
    },
    {
      "text": "Shave parsley leaves off the stems; discard stems and mince the leaves. Add to the bowl."
    },
    {
      "text": "Drain and mince artichokes. Add to the bowl, along with the chickpeas, and stir to combine the salad."
    },
    {
      "text": "To serve, divide chickpea salad between plates or bowls and enjoy!"
    }

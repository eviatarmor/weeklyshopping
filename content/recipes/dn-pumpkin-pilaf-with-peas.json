  "steps": [
    {
      "text": "Prep ingredients: Bring a kettle to the boil. Finely chop the onion and 2 garlic cloves. Peel and coarsely grate the pumpkin.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56316/photos/large/DNY_Recipe_Card_New_Illustration_01-3c5e09c19014ea60abcdf05ac61091d4.jpg"
    },
    {
      "text": "Make stock: Crumble the stock cubes into a heatproof jug, add 400ml boiling water and stir to combine.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56317/photos/large/DNY_Recipe_Card_New_Illustration_02-2926580d9bbc8c56d65fa9aea6b809f9.jpg"
    },
    {
      "text": "Start pilaf: Heat 1 tbs olive oil in a large saucepan over medium heat and cook the onion and garlic, stirring regularly, for 2-3 mins until softened. Add the ras el hanout spice blend and cook, stirring, for 30 secs or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56318/photos/large/DNY_Recipe_Card_New_Illustration_03-a49ec27f5bf99ddf4ba0511d16af9859.jpg"
    },
    {
      "text": "Add pumpkin: Stir in the rice, mixing well to coat in the spices. Add the grated pumpkin and stock, stir to combine and bring to the boil. Cover, then reduce the heat to low and simmer for 15 mins or until the liquid is absorbed.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56319/photos/large/DNY_Recipe_Card_New_Illustration_04-bc759d4f4e2c78354fd94ba1a59b85a9.jpg"
    },
    {
      "text": "Serve up: Remove from the heat. Stir in the peas, season with salt and pepper, then cover and sit for 2-3 mins until the peas are heated through. Divide the pilaf among plates to serve.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56320/photos/large/DNY_Recipe_Card_New_Illustration_05-5a7a1690f603c65ff6737795493d279d.jpg"
    },
    {
      "text": "Extra credit: For added sweetness, stir 2 tbs raisins into the rice before serving. You could also serve the pilaf with a dressed mixed salad.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/56321/photos/large/DNY_Recipe_Card_New_Illustration_HACK-4d24763fbe97269c0089cc30f420a7fa.jpg"
    }
  ]
}

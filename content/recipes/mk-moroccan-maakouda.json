  "steps": [
    {
      "text": "Boil the potatoes and carrots and cut into cubes. Hard-boil 3 of the eggs, peel and dice. Lightly blanch the peas. Preheat the oven to 180°C."
    },
    {
      "text": "Mix all the pie ingredients together (the potato, carrot, diced eggs, peas, parsley, spices, lemon juice and 8 beaten eggs), except the oil."
    },
    {
      "text": "Heat the oil in a pot on the stovetop. When hot, pour in the mixture and cook for about 5 minutes."
    },
    {
      "text": "Transfer the pot to the oven and bake like a cake for about 25 minutes, or until the top is golden."
    }
  ]

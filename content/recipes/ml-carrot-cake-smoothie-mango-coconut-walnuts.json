  "steps": [
    {
      "text": "This recipe will make about 8 cups. Work in batches to best fit your blender."
    },
    {
      "text": "Wash, peel, and trim off the ends of the carrots. Chop into 1-inch chunks and add to blender."
    },
    {
      "text": "Wash, dry, peel, and slice ginger; add to blender. (If you have a high powered blender, you can put the peeled chunk in whole)."
    },
    {
      "text": "Peel bananas, break into chunks and add to blender."
    },
    {
      "text": "Add almond milk, yogurt, mango, walnuts, coconut, cinnamon, and 8 ice cubes to the blender."
    },
    {
      "text": "Blend on high speed for several minutes until smooth."
    },
    {
      "text": "Pour the smoothie into glasses, top with shredded coconut and enjoy!"
    }
  ]

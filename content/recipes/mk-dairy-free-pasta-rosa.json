  "steps": [
    {
      "text": "Add the olive oil, halved cherry tomatoes, crushed garlic and tomato paste to a medium pot. Mix well."
    },
    {
      "text": "Add the coconut cream, salt, pepper, chilli flakes and the pasta. Add the water and mix well."
    },
    {
      "text": "Bring to the boil, reduce the heat and cook for 15 to 20 minutes until the pasta is tender."
    },
    {
      "text": "Stir the pasta a few times while cooking so it does not stick to the pot. Serve topped with fresh basil."
    }

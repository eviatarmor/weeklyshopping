  "steps": [
    {
      "text": "Preheat the oven to 180°C, line a tray with baking paper and spread a generous amount of olive oil over the paper."
    },
    {
      "text": "Mix all the batter ingredients in a wide, shallow bowl until smooth."
    },
    {
      "text": "Break the mushrooms into pieces about 6 x 6 cm, dip them in the batter, then in breadcrumbs, and place on the tray. Bake for 15 minutes, turn, and bake for 10 more minutes until golden."
    },
    {
      "text": "Make the sauce: blend all the sauce ingredients except the celery with a stick blender until smooth and creamy, then stir in the very finely chopped celery. Serve with the mushrooms."
    }
  ]

  "steps": [
    {
      "text": "Fill a medium saucepan halfway with hot water (from the tap), cover, and bring to a boil. Uncover, add salt and pasta, and stir for a few seconds. Cook until desired firmness, 8-10 minutes."
    },
    {
      "text": "Meanwhile, place yogurt, mayo, vinegar, Dijon, honey, and spices in a medium bowl. Whisk to combine the dressing."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Trim and small dice celery. Add to the bowl with the dressing."
    },
    {
      "text": "Peel, trim, and small dice carrots. Add to the bowl."
    },
    {
      "text": "Trim, seed, and small dice bell pepper. Add to the bowl."
    },
    {
      "text": "When the pasta is done, drain and rinse under cold water to cool; add to the bowl. Stir to combine the macaroni salad."
    },
    {
      "text": "To serve, divide macaroni salad between plates or bowls. Enjoy!"
    }
  ]

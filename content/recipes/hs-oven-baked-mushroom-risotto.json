  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Crush the porcini mushrooms coarsely in a food processor."
    },
    {
      "text": "Heat the oil in an ovenproof pot and fry the onion, thyme, crushed porcini and fresh mushrooms for about 2 minutes until golden. If there is not enough liquid in the pot, add 1-2 tablespoons of boiling water so the onion and mushrooms do not burn."
    },
    {
      "text": "Add the rice and stir. Pour in the white wine and cook until it evaporates."
    },
    {
      "text": "Pour the boiling water into the pot, add the salt, stir and bring to the boil. Taste and add more salt if needed."
    },
    {
      "text": "Cover and transfer to the oven. Bake for 20 minutes."
    },
    {
      "text": "Remove the pot from the oven and add the parmesan, butter, parsley, brandy and garlic. Stir until creamy and serve immediately."
    }
  ]

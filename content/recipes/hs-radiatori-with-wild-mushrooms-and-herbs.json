  "steps": [
    {
      "text": "Put 4 tbsp olive oil, the garlic, oregano, parsley leaves and basil leaves in a food processor and blend to a rough paste."
    },
    {
      "text": "Heat 2 tbsp olive oil in a wide, deep frying pan and saute the mushroom strips with salt and pepper for about 3 minutes."
    },
    {
      "text": "Meanwhile, cook the pasta in a large pot of boiling salted water until al dente. Keep 1/4 cup of the cooking water."
    },
    {
      "text": "Add the herb paste, the cooked pasta (with the saved cooking water) and the grated lemon zest to the mushrooms, stir for a minute or two and serve. Serve with grated pecorino if you like."
    }
  ]

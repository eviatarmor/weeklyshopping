  "steps": [
    {
      "text": "Finely dice the leek (the middle part between the white and green), onions and celery."
    },
    {
      "text": "Heat olive oil in a pot and fry the onions, leek and celery until browned. Add the rice and stir."
    },
    {
      "text": "Add the salt, sage, white wine and butter and stir."
    },
    {
      "text": "Add the warm water, bay leaves, allspice and saffron and bring to the boil. Reduce to medium heat and cover."
    },
    {
      "text": "After 7 minutes, turn off the heat and leave the pot covered for about 5 minutes, then serve."
    }
  ]

  "steps": [
    {
      "text": "Preheat the oven to 200°C."
    },
    {
      "text": "Mix the pumpkin (peeled, cut into 3 cm cubes) with the oil, chopped garlic (2 cloves), chilli, 1 tsp ginger, turmeric, coriander, tomato paste and salt in an oven bag. Place in a tray and pierce the bag."
    },
    {
      "text": "Bake for about 40 minutes until the pumpkin is tender and golden at the edges."
    },
    {
      "text": "Mix the yoghurt sauce: yoghurt, 1 crushed garlic clove, 0.5 tsp grated ginger and the crumbled dried mint."
    },
    {
      "text": "Serve the pumpkin in flatbread or over rice with the sauce on the side."
    }
  ]

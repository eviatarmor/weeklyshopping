  "steps": [
    {
      "text": "Combine the bulgur, boiling water and a little salt in a small pot and bring to the boil."
    },
    {
      "text": "Reduce the heat, cook for 10 minutes and let cool."
    },
    {
      "text": "Coarsely grate the onions and beetroot and squeeze out the liquid. In a bowl mix the bulgur with everything except the flour, then add the flour and mix until combined."
    },
    {
      "text": "With wet or oiled hands, shape into flat patties 4-5 cm wide."
    },
    {
      "text": "Shallow fry for 4 minutes or until golden on both sides. Serve with tahini seasoned with lemon."
    },
    {
      "text": "To bake instead, preheat the oven to 180°C, line a tray with lightly oiled baking paper, arrange the patties, spray with oil and bake for 15-20 minutes until golden on both sides."
    }
  ]

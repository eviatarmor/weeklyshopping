  "steps": [
    {
      "text": "• Preheat oven to 220°C/200°C fan-forced.\n• Finely chop brown onion.\n• Finely chop or crush garlic.",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/recipe/step-650bc82e92f5adee543bd05a-87a4b1d4.jpeg"
    },
    {
      "text": "• Heat a drizzle of olive oil in a large frying pan over medium-high heat. Cook onion and mushrooms until softened, 5-6 mins.\n• Add garlic and cook until fragrant, 1 min.\n• Add garlic seasoning, Italian herbs, the water, arborio rice and vegetable stock powder. Bring to boil, then remove from heat.",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/recipe/step-650bc82e92f5adee543bd05a-7e98bad1.jpeg"
    },
    {
      "text": "• Transfer risotto to a large baking dish.\n• Cover tightly with foil and bake until liquid is absorbed and rice is ‘al dente’, 24-28 mins.",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/recipe/step-650bc82e92f5adee543bd05a-39c6042a.jpeg"
    },
    {
      "text": "• Stir fetta cubes, the butter and baby spinach through risotto.\n• Add a splash of water to loosen risotto if needed. Season to taste.\n• Divide risotto between bowls. Sprinkle with flaked almonds.",
      "imageUrl": "https://img.hellofresh.com/f_auto,fl_lossy,q_auto,w_800/hellofresh_s3/recipe/step-650bc82e92f5adee543bd05a-b3141343.jpeg"
    }
  ]

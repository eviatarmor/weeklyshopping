      "qty": 1,
      "unit": "tsp",
      "product": "baking-powder"
    }
  ],
  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Heat olive oil in a pan and fry the onions and leek for about 10 minutes, seasoning and stirring occasionally."
    },
    {
      "text": "Slice the zucchini into medium slices and add to the pan."
    },
    {
      "text": "Season and keep frying the zucchini and onions until lightly golden."
    },
    {
      "text": "Cool the vegetables and transfer to a bowl. Add the eggs, flour and baking powder and mix everything together."
    },
    {
      "text": "Pour the mixture into a lightly greased 26-28 cm tin and bake until golden (about 40 minutes)."
    }
  ]

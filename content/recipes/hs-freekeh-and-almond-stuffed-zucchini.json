  "steps": [
    {
      "text": "Soak the freekeh in boiling water until it opens and the grains swell."
    },
    {
      "text": "Hollow out the zucchini with a corer and use the flesh to line the bottom of a wide pot."
    },
    {
      "text": "Crush the spices with a mortar and pestle. Mix the freekeh with the parsley, almonds, finely chopped onion, the spice mix and olive oil."
    },
    {
      "text": "Fill the zucchini and lay them in the pot. Scatter any leftover freekeh between them. Cover with vegetable stock and 2 tbsp olive oil, then season with salt and pepper."
    },
    {
      "text": "Cover and cook for 45 minutes over low heat after it comes to the boil."
    }
  ]

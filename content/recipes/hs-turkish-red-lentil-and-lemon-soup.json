  "steps": [
    {
      "text": "Finely chop the onions and roughly chop the garlic. Rinse and drain the lentils well."
    },
    {
      "text": "Heat the olive oil in a large pot over medium heat. Add the onion and garlic and sweat for about 5 minutes, stirring occasionally, until soft."
    },
    {
      "text": "Add the lentils, water, tomato paste and sugar. Season with paprika, oregano, salt and pepper, stir and bring to the boil."
    },
    {
      "text": "Reduce the heat, cover and cook for 6-8 minutes until the lentils are soft."
    },
    {
      "text": "Stir in the lemon juice, then taste and adjust the seasoning."
    },
    {
      "text": "Ladle into bowls and serve with lemon wedges."
    }
  ]

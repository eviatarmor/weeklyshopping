  "steps": [
    {
      "text": "Preheat a skillet over medium-high heat. Add almonds and toast, stirring often, until golden brown, 2-3 minutes. Set aside to cool."
    },
    {
      "text": "In a medium bowl, whisk together ricotta, milk, and honey."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Halve the grapes."
    },
    {
      "text": "Peel the bananas, halve lengthwise, and slice."
    },
    {
      "text": "Trim off the ends and peel the kiwis; quarter lengthwise, then chop crosswise."
    },
    {
      "text": "To serve, transfer ricotta mixture to bowls; top with fruit and almonds. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Preheat the oven to 210°C. Line a baking tray with baking paper and brush with a little olive oil."
    },
    {
      "text": "Finely chop the green part of the silverbeet and the white part of the leek. Coarsely grate the carrot and zucchini and squeeze out the liquid well."
    },
    {
      "text": "Mix all the ingredients in a large bowl."
    },
    {
      "text": "With wet or oiled hands, shape into flat patties 5-6 cm wide. Place on the tray and brush with a little olive oil."
    },
    {
      "text": "Bake for 8-10 minutes. When the bases are browned, flip and bake for 3 more minutes or until the patties are firm and golden."
    },
    {
      "text": "Serve hot or at room temperature with a salad."
    }
  ]

  "steps": [
    {
      "text": "Wash and dry the fresh produce. (Skip the spring mix if it came pre-washed.)"
    },
    {
      "text": "Drain and rinse the chickpeas; transfer to a medium bowl."
    },
    {
      "text": "Shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl."
    },
    {
      "text": "Add mayo, Dijon, vinegar, and spices to the bowl."
    },
    {
      "text": "Use a fork or potato masher to crush the chickpeas, making a semi-smooth spread. Set aside."
    },
    {
      "text": "Peel, trim, and julienne or coarsely grate the carrots."
    },
    {
      "text": "Slice tomatoes."
    },
    {
      "text": "Place bread slices on a flat surface. Spread half of the slices with a thick layer of chickpea salad and top carrots, tomato, and spring mix. Cover sandwiches with remaining bread slices."
    },
    {
      "text": "Slice strawberries in half."
    },
    {
      "text": "To serve, divide sandwiches and strawberries between plates and enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Mix all the dough ingredients in a mixer with a dough hook until combined, adding water if needed. Knead for 10 minutes on medium speed until slightly sticky. Cover with cling film and let rise until doubled."
    },
    {
      "text": "Flour the work surface well with cornflour. Divide the dough into 3 parts and roll each to 1/2 cm thick. Cut 12 cm rounds."
    },
    {
      "text": "Spoon tomato sauce into the centre of each round and sprinkle with the crumbled feta, grated mozzarella and yellow cheese. Fold into half-moons and press the edges with your fingers or a fork."
    },
    {
      "text": "Place on trays lined with baking paper, cover with towels and let rise a second time for 45-60 minutes."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Brush with beaten egg and sprinkle with sesame seeds. Bake for 30 minutes until golden. Cool slightly."
    }
  ],

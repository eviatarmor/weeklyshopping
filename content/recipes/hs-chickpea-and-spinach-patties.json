  "steps": [
    {
      "text": "Heat oil in a frying pan and fry the chopped onion until golden. Add the spinach and fry for 1 to 2 minutes until coated in oil. Transfer to a bowl."
    },
    {
      "text": "Roughly mash the chickpeas with a fork or potato masher and add them to the bowl. Add the egg, breadcrumbs and spices and mix. Refrigerate for 30 minutes to firm up."
    },
    {
      "text": "Heat oil in a non-stick frying pan. Shape the mixture into long, compact patties using 2 spoons or wet hands. Fry in batches for 2 to 3 minutes each side until browned, then drain on paper towel."
    },
    {
      "text": "Serve hot or at room temperature with lemon wedges."
    }
  ]

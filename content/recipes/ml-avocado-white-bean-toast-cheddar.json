  "steps": [
    {
      "text": "Drain and rinse beans in a colander; set aside to drain further."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Halve and pit the avocados. Cut into chunks while still in the skin, then scoop out into a medium bowl."
    },
    {
      "text": "Juice lemon into the bowl with the avocado."
    },
    {
      "text": "Peel and mince garlic; add to the same bowl."
    },
    {
      "text": "Add beans and spices to the bowl with the avocado; mash until well combined but still slightly chunky."
    },
    {
      "text": "Medium dice tomatoes."
    },
    {
      "text": "Slice cheese."
    },
    {
      "text": "Toast bread if desired."
    },
    {
      "text": "To serve, divide toast between plates, top with cheese, avocado-bean mix, and tomatoes. Enjoy!"
    }

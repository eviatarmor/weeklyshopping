  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Drain and rinse the beans in a colander; set aside to drain further."
    },
    {
      "text": "Seed and medium dice the bell peppers."
    },
    {
      "text": "Peel and small dice the onion."
    },
    {
      "text": "Preheat a large skillet over medium-high heat."
    },
    {
      "text": "Peel and mince the garlic."
    },
    {
      "text": "Once the skillet is hot, add oil and swirl to coat the bottom."
    },
    {
      "text": "Add onion, bell pepper, and garlic to the skillet; cook, stirring occasionally, until softened, 5-6 minutes."
    },
    {
      "text": "Grate mozzarella."
    },
    {
      "text": "Add beans, corn, tomato sauce, and spices to the skillet, stirring to combine. Reduce heat to low and simmer for 15 minutes, stirring occasionally."
    },
    {
      "text": "Meanwhile, halve and pit the avocadoes. Slice while still in the skin, then scoop out into a medium bowl; mash slightly with a fork."
    },
    {
      "text": "Medium dice the tomatoes; place in the bowl with the avocado."
    },
    {
      "text": "Juice limes into the bowl, add salt, and stir to combine."
    },
    {
      "text": "Separate whole leaves from the head of romaine to use as taco shells."
    },
    {
      "text": "To serve, arrange romaine leaves on plates and fill with seasoned beans and veggies. Top with guacamole and cheese. Enjoy!"
    }
  ]

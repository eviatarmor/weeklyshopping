  "steps": [
    {
      "text": "Mix the peeled, roughly chopped fava beans with the finely chopped parsley, mint, spring onions and celery in a bowl."
    },
    {
      "text": "Place the grated onion, zucchini and potato in a colander, add a little salt and leave for a few minutes until they release liquid. Squeeze out very well by hand and add to the bowl."
    },
    {
      "text": "Add the spices, flour and eggs and mix well."
    },
    {
      "text": "Heat the oil in a frying pan and drop in spoonfuls of the mixture. Fry on both sides until browned, then transfer to a plate lined with paper towel."
    }
  ]

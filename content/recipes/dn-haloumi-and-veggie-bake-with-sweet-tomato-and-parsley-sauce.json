  "steps": [
    {
      "text": "Prep veggies: Cut the zucchini, capsicum and tomatoes into 3cm chunks. Roughly chop the parsley, discarding the stems (see Kitchen notes). Crush or finely chop 2 garlic cloves.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133146/photos/large/DNY_Recipe_Card_New_Illustration_01-3c5e09c19014ea60abcdf05ac61091d4.jpg"
    },
    {
      "text": "Cook veggies: Heat 1 tbs olive oil in a medium ovenproof frypan (see Kitchen tip) over medium heat. Cook the zucchini and capsicum, stirring occasionally, for 5-7 mins until golden. Add the garlic and half the cumin and coriander spice blend and cook for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133147/photos/large/DNY_Recipe_Card_New_Illustration_02-2926580d9bbc8c56d65fa9aea6b809f9.jpg"
    },
    {
      "text": "Simmer sauce: Preheat the grill to high. Add the tomato, 1 tbs red wine vinegar and 1 tsp honey to the pan. Cook, stirring occasionally, for 4 mins or until the tomato has broken down. Stir in half the parsley, season with salt and pepper, then remove the pan from the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133148/photos/large/DNY_Recipe_Card_New_Illustration_03-a49ec27f5bf99ddf4ba0511d16af9859.jpg"
    },
    {
      "text": "Grill haloumi: Put the bread rolls on an oven tray. Thickly slice the haloumi. Arrange the haloumi on top of the veggie mixture, drizzle with 2 tsp honey, then grill on the top shelf for 2 mins or until the haloumi is golden. Put the rolls on the lower shelf and cook for 2 mins or until warmed through.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133149/photos/large/DNY_Recipe_Card_New_Illustration_04-bc759d4f4e2c78354fd94ba1a59b85a9.jpg"
    },
    {
      "text": "Serve up: Scatter the remaining parsley over the veggie bake, then divide among bowls or pop the pan in the centre of the table for everyone to help themselves. Serve with the warm bread rolls.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133150/photos/large/DNY_Recipe_Card_New_Illustration_05-5a7a1690f603c65ff6737795493d279d.jpg"
    },
    {
      "text": "Kitchen tip: If you don't have an ovenproof frypan, you can wrap the handle with a double layer of foil or transfer the veggie mixture to an ovenproof dish before grilling.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/133151/photos/large/DNY_Recipe_Card_New_Illustration_HACK-4d24763fbe97269c0089cc30f420a7fa.jpg"
    }
  ]
}

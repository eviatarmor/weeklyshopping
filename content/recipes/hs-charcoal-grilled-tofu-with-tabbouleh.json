  "steps": [
    {
      "text": "Soak the bulgur in lukewarm water for about 20 minutes and drain well."
    },
    {
      "text": "Char the eggplant over an open flame, peel and chop. Cut the tomato and cucumber into small cubes and chop the spring onions and herbs."
    },
    {
      "text": "Mix the bulgur with all the vegetables and herbs and season with olive oil, lemon juice, salt and black pepper."
    },
    {
      "text": "Grill the block of tofu over charcoal for about 2 minutes on each side, then slice thinly."
    },
    {
      "text": "To serve, place two spoonfuls of tabbouleh in the centre of each plate and top with slices of grilled tofu."
    }
  ]

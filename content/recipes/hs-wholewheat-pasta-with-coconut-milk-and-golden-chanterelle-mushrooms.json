  "steps": [
    {
      "text": "Cook the pasta al dente according to the packet directions."
    },
    {
      "text": "Heat the olive oil in a frying pan and fry the grated ginger for about 30 seconds. Add the sliced leek and fry until soft."
    },
    {
      "text": "Add the chopped mushrooms and fry for about 30 seconds, then add the coconut milk, date syrup and pasta."
    },
    {
      "text": "Cook over low heat until the sauce thickens slightly and coats the pasta well. Season with salt and pepper."
    },
    {
      "text": "Garnish with sliced spring onion and serve."
    }

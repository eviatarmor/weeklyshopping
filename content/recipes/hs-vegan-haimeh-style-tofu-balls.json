  "steps": [
    {
      "text": "Process the coriander, 4 garlic cloves, wakame, chillies and 10 tbsp of olive oil in a food processor until smooth."
    },
    {
      "text": "Mix the tofu, flour, salt and pepper until combined. Combine with the herb mixture. Shape into 45 g balls and bake for 8 minutes in an oven preheated to 180°C."
    },
    {
      "text": "Heat a large pot and fry the capsicum strips with the remaining 4 chopped garlic cloves. Add the remaining olive oil and the diced tomatoes and stir until a smooth sauce forms. Add the chickpeas (soaked overnight), reduce the heat and cook for 30 to 40 minutes, until the capsicum is soft."
    },
    {
      "text": "Add the tofu balls to the sauce and serve."
    }
  ]

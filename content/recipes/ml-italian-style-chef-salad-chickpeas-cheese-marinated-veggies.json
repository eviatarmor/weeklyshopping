  "steps": [
    {
      "text": "Drain and rinse chickpeas. Place in a medium bowl along with vinegar and salt; stir to combine and set aside to marinate."
    },
    {
      "text": "Place dressing, mayo, and salt in a small bowl. Stir to combine and set aside."
    },
    {
      "text": "Drain and roughly chop roasted peppers and artichoke hearts. Transfer both to a plate."
    },
    {
      "text": "Slice eggs crosswise. Season with salt, then add to the plate with the roasted peppers and artichoke hearts."
    },
    {
      "text": "Wash, dry, and halve tomatoes lengthwise. Add to the plate."
    },
    {
      "text": "Wash, dry, and chop (or tear) lettuce into bite-sized pieces."
    },
    {
      "text": "To serve, divide lettuce between plates or bowls. Top with marinated chickpeas, roasted peppers, artichoke hearts, eggs, tomatoes, and cheese. Drizzle with the dressing and enjoy!"
    }
  ]

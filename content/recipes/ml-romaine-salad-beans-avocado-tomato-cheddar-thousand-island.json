  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Drain and rinse the beans; set aside to drain further."
    },
    {
      "text": "Peel and mince garlic; mince capers. Place both in a small bowl along with yogurt, ketchup, mayo, vinegar, water, salt, and pepper; whisk to combine the dressing and set aside."
    },
    {
      "text": "Halve tomatoes and place on a large plate."
    },
    {
      "text": "Trim green onions and cut crosswise into ¼-inch pieces; add to the plate with the tomatoes."
    },
    {
      "text": "Halve and pit the avocados; slice crosswise while still in the skin and scoop out with a spoon. Add to the plate."
    },
    {
      "text": "Coarsely grate cheese and add to the plate."
    },
    {
      "text": "Chop or tear romaine leaves into bite-sized pieces."
    },
    {
      "text": "Divide the romaine between plates or bowls; top with beans, tomato, avocado, and cheese. Sprinkle with green onions and serve with dressing on the side. Enjoy!"
    }
  ]

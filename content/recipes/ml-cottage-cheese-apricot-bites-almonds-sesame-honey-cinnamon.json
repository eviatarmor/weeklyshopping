  "steps": [
    {
      "text": "Wash, dry, and halve apricots lengthwise (around the pit); twist halves to separate, then remove and discard pits. Arrange on a baking sheet pan or platter, cut-side facing up."
    },
    {
      "text": "Top each apricot half with 1 tablespoon of cottage cheese."
    },
    {
      "text": "Roughly chop almonds. Sprinkle almonds and sesame seeds over the apricots."
    },
    {
      "text": "To serve, divide apricots between plates. Drizzle with honey and sprinkle with cinnamon. Enjoy!"
    }
  ]

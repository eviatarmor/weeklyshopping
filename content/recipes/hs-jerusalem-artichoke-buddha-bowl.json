  "steps": [
    {
      "text": "Make the dressing by blending all the dressing ingredients until smooth. Adjust the seasoning."
    },
    {
      "text": "Drain the soaked spelt, place in a pot, cover with water and cook over medium heat for 25 to 30 minutes. Drain and cool."
    },
    {
      "text": "Preheat the oven to 190°C. Cut the Jerusalem artichokes into rough pieces, place on a baking tray lined with baking paper, drizzle with olive oil and a little salt, wrap in baking paper and bake for about 30 minutes until soft."
    },
    {
      "text": "Blanch the fresh black-eyed beans. Slice the avocado, halve the tomatoes, thinly slice the red onion and radishes, chop the spring onions and coriander, and peel the zucchini into ribbons."
    },
    {
      "text": "Arrange the vegetables and spelt in groups in bowls. Drizzle with the dressing or serve it on the side."
    }
  ]

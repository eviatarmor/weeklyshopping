  "steps": [
    {
      "text": "Place oil, vinegar, and spices in a medium bowl. Whisk to combine the dressing."
    },
    {
      "text": "Peel, halve, and slice shallot crosswise into thin half moons. Add to the bowl with the dressing and stir to coat. Set aside."
    },
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Large dice tomatoes. Add to the bowl with the dressing and shallot."
    },
    {
      "text": "Trim, seed, and large dice bell pepper. Add to the bowl."
    },
    {
      "text": "Trim and large dice cucumber. Add to the bowl."
    },
    {
      "text": "Halve olives lengthwise. Add to the bowl, along with the feta, and stir to combine the salad."
    },
    {
      "text": "To serve, divide salad between bowls and enjoy!"
    }
  ]

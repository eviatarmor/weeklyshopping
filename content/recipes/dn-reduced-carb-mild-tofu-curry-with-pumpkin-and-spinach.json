  "steps": [
    {
      "text": "Prep ingredients: Peel the pumpkin, then cut into 2cm chunks. Cut the tofu into 2cm pieces. Crumble 1 stock cube into a heatproof jug, add 125ml (½ cup) boiling water and stir to dissolve.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091898/photos/large/prep_ingredients-4a8ce31d3093d4c545f7bfb5b7dbbe9f.jpeg"
    },
    {
      "text": "Start curry: Heat 2 tsp vegetable oil in a medium saucepan over medium heat. Cook the pumpkin and masala seasoning, stirring, for 3-4 mins until golden and fragrant (see Make it spicy).",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091899/photos/large/brown_pumpkin-53585c8713724609cae944e70aa4e920.jpeg"
    },
    {
      "text": "Simmer curry: Stir the stock and coconut milk into the pumpkin mixture and season with salt and pepper. Bring to the boil, then reduce the heat to medium-low and cook, covered, stirring occasionally, for 12-15 mins until the pumpkin is tender.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091900/photos/large/simmer_sauce-dbfaccaa85f7797198a46f1d79eb9114.jpeg"
    },
    {
      "text": "Warm tofu: Meanwhile, heat 2 tsp vegetable oil in a medium frypan over high heat. Cook the tofu for 2-3 mins each side until golden and warmed through. Remove the pan from the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091901/photos/large/warm_tofu-f4f6768739255ef4ee1f6fcd1998bcd5.jpeg"
    },
    {
      "text": "Serve up: Stir the spinach leaves into the pumpkin curry and cook, uncovered, for a further 1-2 mins until the spinach is wilted. Divide the curry among bowls, top with the tofu and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091902/photos/large/serve_up-565f10f952dd33727db38a6c47b91f10.jpeg"
    },
    {
      "text": "Make it spicy: Like your curries hot? Fry some chopped fresh chilli with the pumpkin to turn up the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2091903/photos/large/make_it_yours-a088d5049ab7108e4cf887d4950ea032.jpeg"
    }
  ]
}

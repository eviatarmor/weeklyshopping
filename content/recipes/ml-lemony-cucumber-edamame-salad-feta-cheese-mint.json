  "steps": [
    {
      "text": "Wash and dry the fresh produce."
    },
    {
      "text": "Place edamame in the colander and rinse under hot, running water (from the tap) to defrost; set aside to drain."
    },
    {
      "text": "Zest and juice lemon into a medium bowl. Add oil, honey, Dijon, and spices, then whisk to combine the dressing."
    },
    {
      "text": "Trim and small dice cucumber. Add to the bowl with the dressing."
    },
    {
      "text": "Pick mint leaves off the stems; discard stems and mince the leaves. Add to the bowl along with edamame and feta. Stir to combine the salad."
    },
    {
      "text": "To serve, divide salad between plates or bowls and enjoy!"
    }
  ]

  "steps": [
    {
      "text": "This recipe will make about 8 cups. Work in batches to best fit your blender."
    },
    {
      "text": "Wash, dry, peel, and mince ginger; place in a blender."
    },
    {
      "text": "Peel the bananas, break into chunks, and add to the blender."
    },
    {
      "text": "Add pumpkin purée, milk, maple syrup, spices, and 8 ice cubes to the blender."
    },
    {
      "text": "Blend on high speed for several minutes until smooth."
    },
    {
      "text": "Pour the smoothie into glasses. Top with a sprinkle of cinnamon and enjoy!"
    }

  "steps": [
    {
      "text": "Place both quinoas in a pot with the water and salt and bring to the boil. Lower the heat, cover and cook for 20 minutes until the liquid is absorbed. Fluff with a fork."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Lay the kale leaves on a baking tray."
    },
    {
      "text": "Mix the soy sauce, olive oil and sesame oil in a small bowl and pour over the kale. Add the coconut flakes and toss."
    },
    {
      "text": "Bake for 15 minutes until the kale is slightly crisp but not burnt. Cut into bite-sized pieces and transfer, with any liquid, to a large bowl."
    },
    {
      "text": "Add the quinoa, coarsely grated carrots and chickpeas and mix. Adjust the seasoning with soy sauce and serve."
    }
  ]

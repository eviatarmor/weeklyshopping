  "steps": [
    {
      "text": "Place butternut squash, broth, coconut milk, paprika, and salt in a large pot. Stir to combine the soup."
    },
    {
      "text": "Bring the soup to a boil over high heat. Once boiling, reduce heat to low and simmer, stirring occasionally, until squash is very soft, 8-10 minutes."
    },
    {
      "text": "Meanwhile, wash and dry arugula (skip this step if it came pre-washed). Place in a medium bowl."
    },
    {
      "text": "Add carrots, Parmesan, cranberries, and pumpkin seeds to the bowl with the arugula. Set aside."
    },
    {
      "text": "When the soup is done, remove from the heat. Purée with an immersion or regular blender (return to the pan)."
    },
    {
      "text": "Add dressing to the bowl with the arugula and toss to combine the salad."
    },
    {
      "text": "Divide soup between bowls and sprinkle with additional pumpkin seeds; serve with salad on the side. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Heat a pan with the oil, add the sliced mushrooms and fry over high heat until browned. Season with salt and pepper and transfer to a bowl."
    },
    {
      "text": "Add the butter, finely chopped onion and thyme leaves to the pan and fry gently until lightly golden. Add the crushed garlic and fry for another 30 seconds until fragrant but not browned. Transfer to the bowl with the mushrooms, add the ricotta, parmesan and chopped chestnuts and mix."
    },
    {
      "text": "Cut the pastry into 10 cm squares, fill each with a spoonful of filling, brush the edges with beaten egg and fold into triangles."
    },
    {
      "text": "Arrange on a tray lined with baking paper and freeze for about 30 minutes until the pastry firms up again."
    },
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Brush with beaten egg and bake for 15-20 minutes until golden."
    }
  ],

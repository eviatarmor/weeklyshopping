  "steps": [
    {
      "text": "Prep ingredients: Quarter the cucumber and radishes, then thinly slice.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803144/photos/large/392619_1-8158fcf9a89688f5d7cbbb3a5f56de86.jpeg"
    },
    {
      "text": "Soak couscous: Put the couscous in a large heatproof bowl, add 1 tsp kofta seasoning and 1 tsp olive oil, pour over 200ml boiling water and cover with a plate. Stand for 5 mins or until the water is absorbed. Fluff the couscous with a fork.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803145/photos/large/392619_2-850f5fbc8cd6dd7c50e02cbe4a9f9753.jpeg"
    },
    {
      "text": "Warm tofu: Meanwhile, heat 1 tsp olive oil in a medium frypan over medium-high heat. Cook the tofu for 2 mins each side or until golden and warmed through. Stir in the remaining kofta seasoning, 2 tsp honey and 60ml (¼ cup) water and cook, turning the tofu, for 1 min or until coated. Remove from the heat and season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803146/photos/large/392619_3-2c58eb29d3998115e8ac9b804a063ea5.jpeg"
    },
    {
      "text": "Toss couscous salad: Combine 2 tsp olive oil and 1 tsp white wine vinegar in a large bowl. Add the couscous, cucumber and radish and toss to coat. Taste, then season with salt and pepper.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803147/photos/large/392619_4-67748553711fa9d215a8955141720ff9.jpeg"
    },
    {
      "text": "Serve up: Combine 2 tsp olive oil and 1 tsp white wine vinegar in a large bowl. Add the spinach, season with salt and pepper and toss to coat. Combine the hummus and 2 tsp water in a bowl. Divide the couscous salad, dressed spinach and tofu among bowls. Drizzle with the hummus and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803148/photos/large/392619_5-5ee6b0c70f3ef80250ea13bfc891742f.jpeg"
    },
    {
      "text": "Make it yours: Empty out the crisper drawer and boost your veggies by adding whatever you have on hand, from tomatoes to capsicum, or even a handful of nuts and seeds.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2803149/photos/large/392619_6-6008943387a372362a097cc2b5e7fe2e.jpeg"
    }
  ]

  "steps": [
    {
      "text": "Prep ingredients: Preheat the grill to high. Line an oven tray with foil. Thinly slice the tomato.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964904/photos/large/290065_1-8158fcf9a89688f5d7cbbb3a5f56de86.jpeg"
    },
    {
      "text": "Start grilling: Put the garlic bread on the lined tray, butter-side down, and grill for 1-2 mins until lightly toasted.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964905/photos/large/290065_2-850f5fbc8cd6dd7c50e02cbe4a9f9753.jpeg"
    },
    {
      "text": "Add toppings: Turn the garlic bread cut-side up. Spread with the tomato chutney and top with the tomato. Season with salt and pepper, then scatter over the cheese.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964906/photos/large/290065_3-2c58eb29d3998115e8ac9b804a063ea5.jpeg"
    },
    {
      "text": "Finish grilling: Grill the toasties for 2-3 mins until the cheese is melted and golden.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964907/photos/large/290065_4-67748553711fa9d215a8955141720ff9.jpeg"
    },
    {
      "text": "Serve up: Cut the toasties in half, divide among plates and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964908/photos/large/290065_5-5ee6b0c70f3ef80250ea13bfc891742f.jpeg"
    },
    {
      "text": "Make it yours: If you have some on hand, scatter the toasties with chopped parsley, basil or chives for a burst of freshness.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/2964909/photos/large/290065_6-6008943387a372362a097cc2b5e7fe2e.jpeg"
    }
  ]
}

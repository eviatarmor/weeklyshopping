  "steps": [
    {
      "text": "Heat the olive oil in a frying pan and cook the pine nuts with the sage leaves over low heat, stirring, until lightly browned. Add the artichoke halves and the pecorino and cook until the cheese melts."
    },
    {
      "text": "Cook the ravioli according to the packet instructions."
    },
    {
      "text": "Add the cooked ravioli to the sauce and cook together for about 1 minute. Top with micro beetroot and finely chopped mint and serve."
    }

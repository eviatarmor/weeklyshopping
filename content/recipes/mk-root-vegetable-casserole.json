  "steps": [
    {
      "text": "Halve the carrots lengthwise, then cut crosswise into 3-4 cm pieces."
    },
    {
      "text": "Cut the beetroot and kohlrabi lengthwise into eight wedges each."
    },
    {
      "text": "Heat a wide pot and add the oil. Add all the vegetables, the cardamom, bay leaves and sage, salt and pepper, and fry, stirring, for about 3 minutes."
    },
    {
      "text": "Add the remaining ingredients, stir well and bring to the boil."
    },
    {
      "text": "Cover and cook over low heat for about 1 hour, stirring occasionally."
    }
  ]

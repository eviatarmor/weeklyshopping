  "steps": [
    {
      "text": "Prep ingredients: Bring a medium saucepan of salted water to the boil for the pasta. Finely chop the onion. Crush or finely chop 2 garlic cloves. Peel the carrot, then coarsely grate. Coarsely grate the cheese.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253387/photos/large/prep_ingredients-a16e7516f7ad1aa977c5ded9c78af715.jpeg"
    },
    {
      "text": "Cook pasta: Cook three-quarters of the pasta in the pan of boiling water for 8 mins or until al dente. Drain. Meanwhile, heat 1 tbs olive oil in a medium deep frypan over medium heat. Cook the onion and garlic, stirring, for 2-3 mins until softened.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253388/photos/large/cook_pasta-1a5ba4d9ae40a8f8f3dc6bb144cd6b2e.jpeg"
    },
    {
      "text": "Brown plant-based mince: Add the plant-based mince and cook, breaking up the lumps with a spoon, for 4-5 mins until browned. Add the carrot and half the dried oregano and cook for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253389/photos/large/brown_plant_based_mince-1871e9d84c824245570a8739e74cc662.jpeg"
    },
    {
      "text": "Simmer bolognese: Add the passata, 2 tbs tomato paste, 2 tsp red wine vinegar, 1 tsp sugar and 180ml (¾ cup) water, season with salt and pepper and bring to the boil. Reduce the heat to medium and cook for 10-12 mins until slightly thickened. Remove the pan from the heat.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253390/photos/large/simmer_bolognese-8d3453baf2a81b42a5e13d21f4b1c697.jpeg"
    },
    {
      "text": "Serve up: Divide the pasta among bowls and spoon over the bolognese. Scatter over the cheese and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253391/photos/large/serve_up-e0ff61f2d770577df13ae57e45d8c380.jpeg"
    },
    {
      "text": "Make it yours: Bring a personal touch to your plant-based bolognese. Love chilli? Scatter over to serve. Have a veggie patch or leftover herbs in the fridge? Pick a few basil or parsley leaves.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/253392/photos/large/make_it_yours-febbcc12fae18d52aebf6a78d630009a.jpeg"
    }
  ]
}

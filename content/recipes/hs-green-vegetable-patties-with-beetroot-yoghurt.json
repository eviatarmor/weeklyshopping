  "steps": [
    {
      "text": "Blanch the silverbeet in plenty of boiling salted water for 3 minutes, drain and chop the leaves. Discard the thick stalks or chop them very finely."
    },
    {
      "text": "Mix the blanched leaves with the grated zucchini, carrot, potato, onion, garlic, herbs, eggs, flour and spices. Shape into flat round patties about 6 cm across."
    },
    {
      "text": "Heat olive oil in a pan and fry the patties for 2 to 3 minutes on each side until golden."
    },
    {
      "text": "For the beetroot yoghurt, heat 1 tbsp olive oil in a pan and saute the finely grated beetroot with the date syrup, salt and pepper for 3 to 5 minutes until soft. Mix with the yoghurt and serve alongside the patties."
    }
  ]

  "steps": [
    {
      "text": "Preheat the oven to 400°F."
    },
    {
      "text": "Place pitas on a baking sheet pan and spread with pesto."
    },
    {
      "text": "Coarsely grate cheese. Sprinkle over the pesto."
    },
    {
      "text": "Thinly slice sun-dried tomatoes. Arrange tomatoes over the cheese, then sprinkle with Italian seasoning."
    },
    {
      "text": "Place baking sheet in the oven (it doesn't have to be fully heated) and bake until pita bread is lightly crisp and cheese is melted, 5-7 minutes. Remove from oven and let cool slightly before cutting into wedges."
    },
    {
      "text": "To serve, divide pizza wedges between plates. Enjoy!"
    }
  ]

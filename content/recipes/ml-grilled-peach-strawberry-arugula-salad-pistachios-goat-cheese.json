  "steps": [
    {
      "text": "Preheat a grill pan or skillet over medium heat."
    },
    {
      "text": "Wash, halve, and pit peaches."
    },
    {
      "text": "Coat grill or bottom of skillet with oil. Place peaches cut side down on grill/skillet and cook until lightly browned and tender, 2-3 minutes per side. Transfer to a plate."
    },
    {
      "text": "Wash and dry arugula. Transfer to a large bowl."
    },
    {
      "text": "Wash cucumber and strawberries. Medium dice and add cucumber to bowl. Trim stem ends, slice, and add strawberries to bowl."
    },
    {
      "text": "Peel and mince garlic. In a small bowl, prepare dressing by whisking together garlic, oil, vinegar, Dijon, salt, and pepper. Set aside."
    },
    {
      "text": "Slice and add peaches to bowl. Toss salad."
    },
    {
      "text": "Shell pistachios. Crumble goat cheese."
    },
    {
      "text": "To serve, arrange salad on a plate, sprinkle goat cheese and pistachios over top, and drizzle with dressing. Enjoy!"
    }
  ]

  "steps": [
    {
      "text": "Make the falafel mix: soak the chickpeas, then place them in a food processor with the onion, coriander, parsley, garlic, salt, pepper, ground coriander, cumin and baking powder. Process to a uniform mixture."
    },
    {
      "text": "Preheat a sandwich press."
    },
    {
      "text": "Cut the pitas in half crosswise to make two pockets, and fill each pocket with the falafel mix. Do not overfill, so the mix does not escape while grilling."
    },
    {
      "text": "Brush the filled pitas with olive oil on both sides, place in the sandwich press and close. Grill for 10-12 minutes until charred."
    }
  ]

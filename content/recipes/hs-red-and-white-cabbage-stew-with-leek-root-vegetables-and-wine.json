  "steps": [
    {
      "text": "Preheat the oven to 170°C. Soak the rice in water for about half an hour, rinse well and tie it in a cloth nappy or muslin."
    },
    {
      "text": "Heat the olive oil in a wide ovenproof pot. Add the quartered onion, leek, celeriac, quartered parsley roots, carrots, bay leaves, allspice, halved garlic head, herbs, large cabbage wedges, salt and pepper. Sear the vegetables over medium heat for 3 to 5 minutes."
    },
    {
      "text": "Add the vegetable stock and white wine and bring to the boil."
    },
    {
      "text": "Place the tied rice among the vegetables, making sure the liquid covers the rice. Add water if needed. Cover the pot."
    },
    {
      "text": "Transfer to the oven for about 1 hour, opening occasionally to check that the rice stays under the liquid."
    },
    {
      "text": "About 5 minutes before the end, raise the oven to 200°C, remove the lid and let the vegetables brown slightly."
    }
  ]

  "steps": [
    {
      "text": "Cook the pasta according to the packet instructions and drain."
    },
    {
      "text": "Heat the olive oil in a pan. Add the garlic and finely chopped onion and fry, stirring, until lightly golden."
    },
    {
      "text": "Add the tomato paste and cream and stir. Add the spices and stir. Bring to the boil."
    },
    {
      "text": "Add the grated cheese and stir to melt. Add the pasta and mix for about 1 minute, until all the pasta is coated in sauce."
    },
    {
      "text": "Transfer to a serving dish, sprinkle with grated grana padano and dig in."
    }

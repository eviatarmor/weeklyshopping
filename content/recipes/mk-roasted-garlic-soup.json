  "steps": [
    {
      "text": "Preheat the oven to 180°C."
    },
    {
      "text": "Arrange the halved garlic heads in a tray cut side up and drizzle generously with olive oil. Roast for half an hour, then cool."
    },
    {
      "text": "Meanwhile, fry the chopped onion and cubed potato in a pot until lightly golden. Squeeze out the garlic cloves and add to the pot with the white wine. Bring to the boil and cook for 5 minutes."
    },
    {
      "text": "Add the stock, herbs and seasonings, bring to the boil, cover and reduce the heat. Cook for 20 minutes."
    },
    {
      "text": "Add the cream and remove the thyme sprigs."
    },
    {
      "text": "Blend the soup, bring to the boil and serve immediately with croutons and a little parmesan."
    }
  ]

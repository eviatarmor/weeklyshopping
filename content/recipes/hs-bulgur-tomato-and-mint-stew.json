  "steps": [
    {
      "text": "Heat the olive oil in a pot and saute the chopped onions and capsicums until lightly golden. Add the garlic, chilli, grated tomatoes and tomato paste and stir. Season with the dried mint, baharat, salt and pepper and mix well."
    },
    {
      "text": "Add the bulgur and stir for a few minutes until it absorbs the flavours."
    },
    {
      "text": "Pour in the boiling vegetable stock or water, stir, bring to the boil again, reduce the heat, cover and cook for 25-30 minutes until the liquid is absorbed and the bulgur is cooked. Adjust the seasoning."
    },
    {
      "text": "Transfer to bowls, top with triangles of Tzfat cheese, drizzle with goat's yoghurt and sprinkle with chopped mint leaves."
    }
  ]

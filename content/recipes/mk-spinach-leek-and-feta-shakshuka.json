  "steps": [
    {
      "text": "Finely chop the leek. In a large frying pan over low heat, fry the leek in the olive oil for about 30 minutes."
    },
    {
      "text": "Finely chop the chard leaves. Add the chard and salt, stir well and cook for 15 minutes."
    },
    {
      "text": "Roughly chop the spinach. Add the spinach, olives, lemon juice and soy sauce, stir well and steam for 5 minutes in the covered pan."
    },
    {
      "text": "Remove the lid. Crack the eggs over the mixture side by side and keep cooking for another 20 minutes."
    },
    {
      "text": "Crumble the feta over the shakshuka and serve immediately."
    }
  ]

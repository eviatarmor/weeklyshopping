  "steps": [
    {
      "text": "Preheat the oven to 180°C and line a baking tray with baking paper."
    },
    {
      "text": "Season the cauliflower florets with salt and pepper and drizzle with olive oil. Place on the tray and roast for about 20 minutes until golden."
    },
    {
      "text": "Meanwhile, saute the chopped onion and carrot strips in the oil in a pot for about 3 minutes until the onion turns translucent."
    },
    {
      "text": "Add the rice (rinsed and soaked for 10 minutes, then drained), chickpeas, baharat and salt, pour in the water and bring to the boil. Cover and cook for 15 minutes over low heat. Turn off the heat and leave covered for about 10 minutes."
    },
    {
      "text": "Transfer the rice to a serving dish, add the cauliflower and toss. Scatter with almonds and coriander leaves and serve hot."
    }
  ]

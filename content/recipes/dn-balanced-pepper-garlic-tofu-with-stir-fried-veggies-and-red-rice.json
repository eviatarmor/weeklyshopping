  "steps": [
    {
      "text": "Cook rice: Fill a medium saucepan three-quarters full with water and bring to the boil. Add the rice and cook for 25 mins or until tender. Drain.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450411/photos/large/72038_1-080c71ea03031ef520292049051b808c.jpeg"
    },
    {
      "text": "Prep ingredients: Meanwhile, trim the beans. Thinly slice the capsicum. Cut the spring onion into 3cm lengths.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450412/photos/large/72038_2-5f6436c25033c8d6df1c6ac0847531b8.jpeg"
    },
    {
      "text": "Warm tofu: Heat 2 tsp vegetable oil in a medium deep frypan over medium-high heat. Cook the tofu for 2 mins each side or until golden and warmed through. Remove from the pan, reserving the pan. Halve the tofu pieces diagonally to form triangles.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450413/photos/large/72038_3-62b2c8ce0b89b6bece122de42e1fc04e.jpeg"
    },
    {
      "text": "Stir-fry veggies: Heat 2 tsp vegetable oil in the reserved pan over high heat. Stir-fry the beans for 1-2 mins until almost tender. Add the capsicum, spring onion and garlic and stir-fry for 1-2 mins until softened. Add the tofu, pepper and garlic seasoning, 1½ tbs soy sauce and 2 tbs water and stir-fry for 1 min or until fragrant.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450415/photos/large/72038_4-18acb08445f2e2e8c50b27d5247fb8e6.jpeg"
    },
    {
      "text": "Serve up: Divide the rice and tofu stir-fry among bowls. Scatter over the sesame seeds and enjoy!",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450417/photos/large/72038_5-e712580f4f31c47c742aa55e13f2d1a1.jpeg"
    },
    {
      "text": "Make it yours: Like it hot? Kick up the heat with a scattering of chopped fresh chilli or chilli flakes.",
      "imageUrl": "https://marleyspoon.com/media/recipe_card_steps/450419/photos/large/72038_6-b6a95d8227b41215daf87e022f0a6779.jpeg"
    }
  ]
}

  "steps": [
    {
      "text": "Cut a lengthways slit in each onion, down to the centre."
    },
    {
      "text": "Boil a pot of water and cook the onions for 10 minutes until partly softened. Cool a little and separate into layers, discarding the small inner layers."
    },
    {
      "text": "Mix all the filling ingredients (freekeh, grated parsley root and celeriac, parsley, coriander, chopped celery stalks (keep the leaves), dill, pine nuts, raisins, baharat, dried mint, sea salt, white pepper and 1 tablespoon olive oil) in a large bowl."
    },
    {
      "text": "Grease a wide pot with olive oil and line it with the celery leaves. Fill the onion layers with the filling and pack them tightly in the pot. Scatter over the sliced garlic, grapes and mint leaves. Pour over the remaining sauce ingredients (olive oil, salt, pepper, date syrup, pomegranate molasses, pomegranate juice and water), except the lemon juice."
    },
    {
      "text": "Bring to the boil, cover and cook over low heat for about 1 hour until the onions are soft and most of the liquid is absorbed."
    },
    {
      "text": "Add the lemon juice and cook uncovered for about 15 minutes until the sauce thickens."
    },
    {
      "text": "Transfer to a serving plate, drizzle with sauce, scatter with pomegranate seeds and serve."
    }
  ]
}

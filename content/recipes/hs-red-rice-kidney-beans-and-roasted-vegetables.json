  "steps": [
    {
      "text": "Preheat the oven to 200°C and line a baking tray with baking paper."
    },
    {
      "text": "Place the red rice, salt, coconut water and water in a pot and bring to the boil. Reduce the heat, cover and cook for about 40 minutes until the rice is ready."
    },
    {
      "text": "Toss the diced zucchini and carrot and the cauliflower on the tray with 2 tablespoons olive oil, garlic, ginger, herbs, coarse salt and pepper."
    },
    {
      "text": "Bake for 25 minutes until the vegetables are crisp."
    },
    {
      "text": "Stir 1 tablespoon olive oil, the sesame oil, rice vinegar and chilli into the rice."
    },
    {
      "text": "Mix the rice with the cooked kidney beans, roasted vegetables, chopped fresh spinach and coriander. Taste and adjust the seasoning and serve hot."
    }
  ]

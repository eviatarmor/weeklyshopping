  "steps": [
    {
      "text": "Light a charcoal grill (or heat a chargrill pan)."
    },
    {
      "text": "Brush the inside of each pita half with 1 tbsp olive oil and sprinkle with za'atar, salt and pepper."
    },
    {
      "text": "Grill the halloumi cubes (3 cm) and the pita halves on all sides until nicely charred. Remove from the heat."
    },
    {
      "text": "Put all the vegetables (roughly chopped tomatoes and cucumbers, quartered radishes, spring onion in 2 cm sticks and torn lettuce) in a bowl and dress with the remaining olive oil, lemon juice, salt, pepper and fresh za'atar leaves."
    },
    {
      "text": "Tear the pita into pieces, scatter over the salad with the halloumi and serve."
    }
  ]

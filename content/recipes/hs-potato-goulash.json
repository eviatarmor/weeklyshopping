  "steps": [
    {
      "text": "Heat the oil in a wide pot, add the chopped onions and fry for 5 minutes over medium heat until golden. Add the garlic and all the chopped capsicums and chilli, and fry, stirring, for another 3 minutes."
    },
    {
      "text": "Peel the potatoes and cut into 4 cm cubes. Add them to the pot with the salt, both paprikas, caraway and capsicum paste, and fry for 3 minutes."
    },
    {
      "text": "Add the boiling water and bring to the boil. Lower the heat and cook for 20 to 25 minutes until the potatoes are tender."
    },
    {
      "text": "Serve the goulash with sour cream and chopped dill."
    }
  ]

  "steps": [
    {
      "text": "Melt the butter in a pot and saute the finely diced onions for about 4 minutes until translucent. Add the mushrooms (soak the dried porcini in water first), garlic, grated lemon zest, rice and spices and stir until the rice is coated in fat."
    },
    {
      "text": "Add the wine and stir until it is absorbed."
    },
    {
      "text": "Add the boiling stock one ladle at a time, stirring, until each addition is absorbed. Continue until all the stock is used. This should take about 25 minutes, finishing when the rice is still moist."
    },
    {
      "text": "Fold in the chopped dill, grated parmesan and lightly whipped cream. Adjust the seasoning."
    },
    {
      "text": "Serve hot with shavings of parmesan on top."
    }
  ]

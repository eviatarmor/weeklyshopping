  "steps": [
    {
      "text": "Preheat oven to 500°F."
    },
    {
      "text": "Wash, trim root ends, peel, and thinly slice beets into half rounds. Transfer to a sheet pan, drizzle with oil, and season with salt and pepper."
    },
    {
      "text": "Place in the oven and roast until beets are tender, 20 minutes."
    },
    {
      "text": "Wash and dry spinach and oranges. Peel and thinly slice oranges into half rounds."
    },
    {
      "text": "In a medium bowl, prepare dressing by whisking together oil, vinegar, Dijon, salt, and pepper."
    },
    {
      "text": "Crumble goat cheese into a medium bowl. Roughly chop walnuts."
    },
    {
      "text": "To serve, arrange a bed of spinach on a plate and top with beet and orange slices. Sprinkle with goat cheese, walnuts, and drizzle with dressing. Enjoy!"
    }
  ]

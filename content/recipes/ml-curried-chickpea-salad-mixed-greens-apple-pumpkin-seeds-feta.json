  "steps": [
    {
      "text": "Wash and dry the fresh produce. (Skip the mixed greens if they came pre-washed.)"
    },
    {
      "text": "Juice one lemon into a medium bowl. (Set remaining lemon aside for later.)"
    },
    {
      "text": "Drain and rinse chickpeas. Transfer half the chickpeas to the bowl with the lemon juice; add mayo and spices. Using a fork or potato masher, mash until smooth."
    },
    {
      "text": "Add remaining chickpeas to the bowl and stir to combine."
    },
    {
      "text": "Trim and small dice celery; add to the bowl."
    },
    {
      "text": "Chop chives into small pieces and add to the bowl."
    },
    {
      "text": "Using a knife, shave dill leaves off the stems; discard stems and mince the leaves. Add to the bowl and stir to combine the chickpea salad. Set aside."
    },
    {
      "text": "Juice remaining lemon into a large bowl. Add oil, honey, Dijon, salt, and pepper; whisk to combine the dressing."
    },
    {
      "text": "Quarter and core apples, then thinly slice each quarter; add to the bowl with the dressing."
    },
    {
      "text": "Add mixed greens, feta, and pumpkin seeds to the bowl. Toss to combine the salad."
    },
    {
      "text": "To serve, divide green salad between plates or bowls, top with curried chickpea salad, and enjoy!"
    }
  ]
}

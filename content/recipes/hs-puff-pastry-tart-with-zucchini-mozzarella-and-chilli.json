  "steps": [
    {
      "text": "Preheat the oven to 190°C and line a baking tray with baking paper."
    },
    {
      "text": "Slice the zucchini into thin lengthwise ribbons with a vegetable peeler. Place the puff pastry sheet on the tray and gently score a border 1 cm from the edge."
    },
    {
      "text": "Scatter the zucchini, torn mozzarella, chopped garlic and chilli over the pastry. Season with thyme, salt and pepper and drizzle with olive oil."
    },
    {
      "text": "Bake for about 20 minutes until golden and serve hot."
    }
  ]

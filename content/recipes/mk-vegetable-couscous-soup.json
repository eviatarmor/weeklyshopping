  "steps": [
    {
      "text": "Soak the chickpeas in plenty of water overnight."
    },
    {
      "text": "Drain the chickpeas and cook in a pot with plenty of fresh water for about 1 hour after it first boils, or until tender. Set aside."
    },
    {
      "text": "Make the soup: fry the chopped onion in a large pot with the oil for about 5 minutes, until golden. Add the remaining vegetables, herbs, spices and tomato paste and stir until everything is coated in the spices."
    },
    {
      "text": "Add water to cover and bring to the boil."
    },
    {
      "text": "Cover and cook on medium heat for about 45 minutes."
    },
    {
      "text": "Add the chickpeas and cook for another 15 minutes, or until all the vegetables are tender."
    },
    {
      "text": "Cool slightly, taste and adjust the seasoning. Serve over cooked couscous."
    }
  ]
